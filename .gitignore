# Whitelist: everything is ignored, then code, docs and the reviewed inputs are admitted. Data never enters git:
# packages, sweeps, captures, logs, PDFs, sqlite, .gz and model files live on disk and in the dated releases
# (/n/fs/resemble/homogenizing-science/releases/<id>/), not here.
*
!*/
!.gitignore

# code and docs
!*.py
!*.sh
!*.slurm
!*.md
!*.mjs
!*.toml
!*.cfg
!tests/**
!docs/**
!bin/atlas
!tools/hooks/*
!tools/secret_scan_allow.tsv
!.github/**
!env/environment.yml
!env/conda-linux-64.lock
!vendor/PROVENANCE.tsv
!schemas/*.schema.json

# hand-written lists and agent briefs (the only .txt files that are code or docs)
!hierarchy/gap-tools-cmu/batch*.txt
!hierarchy/labpage-tools-cmu/worker_brief.txt
!hierarchy/labpage-tools-princeton-mit/agent-brief.txt

# REVIEWED INPUTS: small hand-curated decisions the builder reads (each < 5 MB; see docs/REVIEWED-INPUTS.md)
!hierarchy/reviewed/census-overrides.json
!hierarchy/reviewed/home-departments.json
!hierarchy/derived/zero-paper-labs.json
!hierarchy/reviewed/zero-paper-review.json
!hierarchy/reviewed/chain-reasons.json
!hierarchy/reviewed/student-corrections.json
!hierarchy/reviewed/student-identity-review.json
!hierarchy/reviewed/student-name-candidates.json
!hierarchy/reviewed/cs-venues.json
!hierarchy/*/reviewed/missing-pi-review.json
!hierarchy/*/reviewed/few-students-evidence.json
!hierarchy/*/reviewed/cs-related-review.json
!hierarchy/*/reviewed/gap-evidence.json
!hierarchy/*/reviewed/relation-evidence.json
!hierarchy/*/reviewed/labpage-additions.json
!hierarchy/*/reviewed/labpage-handcheck.json
!hierarchy/*/reviewed/labpage-acceptance.json
!hierarchy/reviewed/labpage-departure-review.json
!hierarchy/derived/labpage-audit-summary.json
!hierarchy/stanford/reviewed/tobagi-review.json
!hierarchy/reviewed/nicknames/*.csv
!hierarchy/*/reviewed/census-additions.json
!hierarchy/*/reviewed/faculty-periods.json

# generated documents (they go into each release instead)
/hierarchy/derived/reader/
/hierarchy/derived/CHAIN-AUDIT.md
/hierarchy/derived/BUILD-REGRESSION.md
/hierarchy/derived/EVIDENCE-CHECK.md

# data directories: never traversed
logs/
raw/
backups/
__pycache__/
.pytest_cache/
/captures/
/ai-writing/**/data/
/ai-writing/detector/
/ai-writing/detector_v2/models/
/ai-writing/figlab/mini/
/hierarchy/labpage-tools-cmu/state/
/hierarchy/thesis-tools/out/
/hierarchy/labpage-tools-epfl-berkeley/work/
/hierarchy/labpage-tools-epfl-berkeley/discover/
/hierarchy/labpage-tools-epfl-berkeley/local/
/hierarchy/period-tools/proposals/
/hierarchy/cmu/work/labpage-parts/
/hierarchy/*/work/tmp/
/fulltext-push/local-reuse/ident/
/fulltext-push/local-reuse/lists/

# the accuracy sample (2026-10-29; admitted once its secret scan was clean): code, report, verdicts, re-checks; its API cache stays out
!accuracy/*.json
!accuracy/*.jsonl
/accuracy/cache/

# generated by fulltext-push/collectors_status.py
hierarchy/derived/COLLECTORS-STATUS.md
hierarchy/derived/COLLECTORS-STATUS.json

# the split layout (2026-11-01): the flat ignores above, translated; a school's work/ holds rebuildable tool state and scratch (nothing tracked)
/hierarchy/*/work/
