"<html> <head></head> <body>  <div class=\"teacherTabs\" id=\"teacherTabs\">    <div id=\"tabb3830\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh active\" style=\"display: flex;\">     <div class=\"tab_txt\">      基本信息     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabb3831\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      科学研究     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabb3832\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      招生教学     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabb3833\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      教材     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabe2d7f0ae6413b42cc5ae467e10f51143\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      文化生活     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"1d3b3764d1a43abd4cd82f0460efdab5\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     Basic Information    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"baf39fa2d1da75de258442b4cedd6c4a\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     新页签    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div class=\"teacher_TabAdd guideBorder\" style=\"display:flex; background-color:rgb(31, 81, 163);\"></div>   </div>   <div class=\"tacherContent\" style=\"\">    <div class=\"addBtn\" style=\"display:flex;\"> <span class=\"iconAdd\"></span> 新建主栏目    </div>    <div class=\"tacherContentParts\" style=\"\">     <div id=\"tabb3830part\" class=\"part_box\" style=\"display: block;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(248, 174, 122);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3002\"></i><em data-editor=\"0\" data-more=\"1\" id=\"3002\">荣誉称号</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_icon_add\" title=\"添加\"><i class=\"part_icon1 part_icon_add\" style=\"display:flex;\"></i></a><i class=\"part_icon_solid\"></i><a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl>        <ol id=\"60979bc254347726793b9e4583a49599\" class=\"rych\" style=\"padding-left:70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"称号名称\">           称号名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"acquisition time\" data-zh=\"获奖时间\">           获奖时间          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"acquisition address\" data-zh=\"获奖地点\">           获奖地点          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-olname=\"\" data-domtype=\"textarea\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"introduction\" data-zh=\"简单介绍\">           简单介绍          </div>          <div class=\"ol_value\"></div>         </div>        </ol>       </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(248, 174, 122);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">个人简介</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"169449c7adc1451c910bb3b65d211139\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"d3d27996f7d2441dbf9aa7c5a44e42f0\">           <p><br></p>           <p><br></p>           <p><span style=\"font-size:18px;\">刘国栋 <span style=\"font-size:18px;\">教授，博士生导师，<span style=\"font-size:18px;\">哈工大光电测量与控制研究所所长</span></span></span></p>           <p><strong><span style=\"font-size:18px;\">学术荣誉：</span></strong></p>           <ul class=\"list-paddingleft-2\" style=\"list-style-type:square;\">            <li><p><span style=\"font-size:18px;\"><span style=\"font-size:18px;\"> 国家高层次人才</span></span></p></li>            <li><p><span style=\"font-size:18px;\"><span style=\"font-size:18px;\">“龙江学者”特聘教授</span></span></p></li>           </ul>           <p><strong><span style=\"font-size:18px;\"><span style=\"font-size:18px;\"><span style=\"font-size:18px;\">获得奖项：</span></span></span></strong></p>           <ul class=\"list-paddingleft-2\" style=\"list-style-type:square;\">            <li><p><span style=\"font-size:18px;\"><span style=\"font-size:18px;\"><span style=\"font-size:18px;\">国家科技进步二等奖1项</span></span></span></p></li>            <li><p><span style=\"font-size:18px;\"><span style=\"font-size:18px;\"><span style=\"font-size:18px;\">部级技术发明特等奖1项</span></span></span></p></li>            <li><p><span style=\"font-size:18px;\"><span style=\"font-size:18px;\"><span style=\"font-size:18px;\">全国高校十大科技进展1项</span></span></span></p></li>            <li><p><span style=\"font-size:18px;\"><span style=\"font-size:18px;\"><span style=\"font-size:18px;\">部级科技进步一等奖1项</span></span></span></p></li>            <li><p><span style=\"font-size:18px;\"><span style=\"font-size:18px;\"><span style=\"font-size:18px;\">省部级科技进步二等奖1项，三等奖2项</span></span></span></p></li>           </ul>           <p><br></p>           <p><strong><span style=\"font-size:18px;\">主要研究方向：</span></strong></p>           <ul class=\"list-paddingleft-2\" style=\"list-style-type:square;\">            <li><p><span style=\"font-size:18px;\">智能光电传感</span></p></li>            <li><p><span style=\"font-size:18px;\">激光雷达</span></p></li>            <li><p><span style=\"font-size:18px;\">光电仪器</span></p></li>           </ul>           <p><span style=\"font-size:18px;\">担任国家重大项目哈工大项目组副总指挥，主持和参与国家重大项目子项目、国家自然基金项目、省部级重点项目、横向项目等80余项，发表论文50余篇，申请发明专利30余项。</span><br></p>           <p><br></p>           <p style=\"white-space: normal;\"><br></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(248, 174, 122);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">工作经历</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"29b3fb06f525461c9246604fb7d387a9\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"0eeabf160d134974ae716a9448a586ce\">            <p></p>            <table align=\"center\" border=\"1\">             <tbody>              <tr>               <th><span style=\"font-size:18px;\">时间</span></th>               <th><span style=\"font-size:18px;\">工作经历</span></th>              </tr>              <tr>               <td><p><span style=\"font-size:18px;\">1998.07-2000.07</span></p></td>               <td><span style=\"font-size:18px;\">哈尔滨工业大学自动化测试与控制系 助教</span></td>              </tr>              <tr>               <td><p><span style=\"font-size:18px;\">2000.08-2004.07</span></p></td>               <td><span style=\"font-size:18px;\">哈尔滨工业大学自动化测试与控制系 讲师</span></td>              </tr>              <tr>               <td><p><span style=\"font-size:18px;\">2004.08-2008.07</span></p></td>               <td><span style=\"font-size:18px;\">哈尔滨工业大学自动化测试与控制系 副教授</span></td>              </tr>              <tr>               <td><p><span style=\"font-size:18px;\">2008.08-至今</span></p></td>               <td><span style=\"font-size:18px;\">哈尔滨工业大学自动化测试与控制系 教授</span></td>              </tr>              <tr>               <td><p><span style=\"font-size:18px;\">2010.04-至今</span></p></td>               <td><span style=\"font-size:18px;\">哈尔滨工业大学自动化测试与控制系 博导</span></td>              </tr>              <tr>               <td><span style=\"font-size:18px;\">2004.10-2009,10</span></td>               <td><span style=\"font-size:18px;\">哈工大光电测控与智能化研究所 副所长</span></td>              </tr>              <tr>               <td><span style=\"font-size:18px;\">2009.11-至今</span></td>               <td><span style=\"font-size:18px;\">哈工大光电测控与智能化研究所 所长</span></td>              </tr>              <tr>               <td><span style=\"font-size:18px;\">2010.12-2011.07</span></td>               <td><span style=\"font-size:18px;\">哈工大电气工程及自动化学院 院长助理</span></td>              </tr>              <tr>               <td style=\"\"><span style=\"font-size:18px;\">2011.08-2018.12</span></td>               <td><span style=\"font-size:18px;\">哈工大电气工程及自动化学院 副院长</span></td>              </tr>              <tr>               <td><span style=\"font-size:18px;\">2014.12-2015.12</span></td>               <td><span style=\"font-size:18px;\">英国国家物理实验室 访问学者</span></td>              </tr>             </tbody>            </table>            <p><br></p>            <p><br></p>            <p><br></p>            <p></p>           </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(248, 174, 122);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">教育经历</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"dbb703f3f9904fe5b67bedf2abc07323\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"0d212969b1be462c90a6fd560583a83a\">            <p></p>            <p><span style=\"font-size:18px;\">1992.09-1996.07 哈尔滨工业大学应用物理系 理学学士</span></p>            <p><span style=\"font-size:18px;\">1996.09-1998.07 哈尔滨工业大学自动化测试与控制系 工学硕士</span></p>            <p><span style=\"font-size:18px;\">1999.03-2005.06 哈尔滨工业大学自动化测试与控制系 工学博士</span></p>            <p></p>           </div>          </div>         </ol>        </dl></li>      </ul>     </div>     <div id=\"tabb3831part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(248, 174, 122);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">研究领域</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"b3fa7c0662fc4df1b97b6223c5578a0e\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"dd8eb5813314413da8930d210c2eadd5\">           <p><br></p>           <p><span style=\"font-size:18px;\"> 长年围绕惯性约束聚变国家重大需求和精密测量学术研究前沿，开展精密光学测量、传感及智能化领域研究，主要包括：</span></p>           <ol class=\"list-paddingleft-2\" style=\"padding-left:70px;\">            <li><p><span style=\"font-size:18px;\">机器视觉与人工智能：研究机器视觉与人工智能技术，实现目标探测、识别、定位、精密测量。</span></p></li>            <li><p><span style=\"font-size:18px;\">激光精密测量技术：研究激光雷达三维测量技术，激光干涉表面形貌测量技术，激光测振技术，激光位移传感技术。</span></p></li>            <li><p><span style=\"font-size:18px;\">精密仪器与测试技术：研究光电精密测量及传感方法、仪器设计与研发。</span></p></li>           </ol>           <p><br></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(248, 174, 122);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">科研成果</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"facce361d6c64c01871bef606347528d\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"a01322682d3949d286eaac9cce2f429e\">            <p></p>            <p><span style=\"font-size:18px;\">多项创新性研究成果应用于国家重大科研项目，达到国际前沿水平，累计经费近亿元。</span></p>            <p><span style=\"font-size:18px;\">代表性奖项：</span></p>            <p><span style=\"font-size:18px;\"> 国家科技进步二等奖 1项</span></p>            <p><span style=\"font-size:18px;\">部级技术发明特等奖 1项</span></p>            <p><span style=\"font-size:18px;\">全国高校十大科技进展 1项</span></p>            <p><span style=\"font-size:18px;\">部级科技进步一等奖 1项</span></p>            <p><span style=\"font-size:18px;\">部级十大科技创新团队</span></p>            <p><span style=\"font-size:18px;\">省级科技进步二等奖 1项、</span><span style=\"font-size:18px;\">三等奖 2项</span></p>            <p></p>           </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(248, 174, 122);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">科研团队</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"3b792a6e1fa340dda9e1b1f098acc2c1\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"c59cea99fa684ccb8957323cb7748006\">           <p><br></p>           <p><strong><span style=\"font-size:18px;\">教师队伍：</span></strong></p>           <p><span style=\"font-size:18px;\">刘炳国 教授， 副所长，研究方向: 精密光电测量技术；<br> 庄志涛 副教授，副所长， 研究方向: 精密仪器电子及控制技术；</span></p>           <p><span style=\"font-size:18px;\">陈凤东 副教授，研究方向：机器视觉及数据处理技术；</span></p>           <p><span style=\"font-size:18px;\">甘雨 副教授，研究方向：激光雷达技术；</span></p>           <p><span style=\"font-size:18px;\">卢丙辉 助理研究员，研究方向：激光干涉的表面形貌测量技术；</span></p>           <p><span style=\"font-size:18px;\">路 程 助理研究员，研究方向：激光三维测量技术、激光测振技术。</span></p>           <p><span style=\"font-size:18px;\"> </span></p>           <p><strong><span style=\"font-size:18px;\">毕业博士研究生：</span></strong><span style=\"font-size:18px;\">冯博，卢丙辉，尹哲，许新科，路程，魏富鹏</span></p>           <p><strong><span style=\"font-size:18px;\">在读博士研究生：</span></strong><span style=\"font-size:18px;\">于泽浩，邹鹿，韩越越，董航程，许梓艺，张滨选，段长昊，陈冠华，金亮</span></p>           <p><strong><span style=\"font-size:18px;\">在读硕士研究生：</span></strong><span style=\"font-size:18px;\">郑远航，何嘉良，贾乃姝，张旻烨，牛可通</span></p>           <p><strong><span style=\"font-size:18px;\">毕业硕士研究生（按毕业日期）：</span></strong></p>           <p><strong><span style=\"font-size:18px;\"></span></strong></p>           <p><span style=\"font-size:18px;\">2008：慕朝阳，罗立强</span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2009</span><span style=\"font-size:18px; color:black;\">：李延昌，曹旭</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2010</span><span style=\"font-size:18px; color:black;\">：沈金华</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2011</span><span style=\"font-size:18px; color:black;\">：向勇，李鹏英</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2012</span><span style=\"font-size:18px; color:black;\">：田义普，路程</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2013</span><span style=\"font-size:18px; color:black;\">：梁功涛，刘楠，许新科，万霏，唐烽，吴振锋</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2014</span><span style=\"font-size:18px; color:black;\">：徐东坡，魏晓梅，赵昊，路程，姚秋红</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2015</span><span style=\"font-size:18px; color:black;\">：刘芳芳，郭彬，余亚会，魏富鹏</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2016</span><span style=\"font-size:18px; color:black;\">：王津楠，周方正，于泽浩，刘滢，戚子文，单梦圆</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2017</span><span style=\"font-size:18px; color:black;\">：姜桦楠，钟瑶，邹鹿，张立斌</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2018</span><span style=\"font-size:18px; color:black;\">：程书博，张海心，李建禹</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2019</span><span style=\"font-size:18px; color:black;\">：张恩齐，高鹏锟，罗启峰</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2020</span><span style=\"font-size:18px; color:black;\">：赵童，向钿</span></span></p>           <p><span style=\"font-family:微软雅黑,;\"><span style=\"font-size:18px; color:black;\">2021</span><span style=\"font-size:18px; color:black;\">：陈冠华，张秋实，马雪琳，许梓艺，李广民</span></span></p>           <p><span style=\"font-size:18px;\"> </span></p>           <p><strong><span style=\"font-size:18px;\">工程师：</span></strong></p>           <p><span style=\"font-size:18px;\">孙醒凡 教授级高工，工学学士，专业领域：精密仪器设计，精密测量技术；</span></p>           <p><span style=\"font-size:18px;\">卢国忠 工程师， 工学硕士， 专业领域：激光传感技术，精密仪器电子设计；</span></p>           <p><span style=\"font-size:18px;\">卫晶 工程师 ，工学硕士， 专业领域：光学测角技术，软件设计；</span></p>           <p><span style=\"font-size:18px;\">宋静怡 工程师， 工学硕士， 专业领域：光学测角技术，软件设计；</span></p>           <p><span style=\"font-size:18px;\">包新雷 工程师，工学硕士 ， 专业领域：光学设计；</span></p>           <p><span style=\"font-size:18px;\">时圣星 工程师， 工学硕士， 专业领域：电子设计、软件设计；</span></p>           <p><span style=\"font-size:18px;\">王文峰 工程师，工学学士， 专业领域：软件设计；</span></p>           <p><span style=\"font-size:18px;\">李晓原野 工程师， 工学学士， 专业领域：软件设计；</span></p>           <p><span style=\"font-size:18px;\">梁占福 工程师， 专业领域：精密仪器装校；</span></p>           <p><span style=\"font-size:18px;\">刘海波 工程师， 专业领域：测控电气系统设计；</span></p>           <p><br></p>           <p><br></p>           <p><br></p>           <p><br></p>           <p><br></p>           <p><br></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>      </ul>     </div>     <div id=\"tabb3832part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(248, 174, 122);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">招生信息</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"47fbd7da0b0643cdaf0aa4e802df4ebb\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"10164016cbc34036a072dcb38685683d\">            <p></p>            <p><span style=\"font-size:18px;\"><strong>招收研究生专业范围：仪器科学，光学，物理，机械，电子，控制，计算机；</strong></span></p>            <p><br><span style=\"font-size:18px;\"><strong>博士招生:</strong><br>每年招收统考全日制博士研究生2-3名；</span></p>            <p><span style=\"font-size:18px;\">根据个人意愿和团队需求，提供灵活的CSC、短期访学、交换生等出国研修机会。</span></p>            <p><span style=\"font-size:18px;\"> </span></p>            <p><span style=\"font-size:18px;\"><strong>硕士招生:</strong><br>每年招收硕士研究生3名。</span></p>            <p><span style=\"font-size:18px;\"> </span></p>            <p></p>           </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(248, 174, 122);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">讲授课程</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"f00518d7e7734fc4b6a4c005382c813c\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"cbc2db67b696428e8d382f8fd2e1f99c\">            <p></p>            <p> </p>            <ol class=\"list-paddingleft-2\" style=\"padding-left:70px;\">             <li><p><span style=\"font-size:18px;\">光电测试技术 （研究生）</span></p></li>             <li><p><span style=\"font-size:18px;\">工程光学 （本科生）</span></p></li>            </ol>            <p> </p>           