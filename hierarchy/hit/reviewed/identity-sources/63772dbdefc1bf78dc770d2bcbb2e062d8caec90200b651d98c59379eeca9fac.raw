"<html> <head></head> <body>  <div class=\"teacherTabs\" id=\"teacherTabs\">    <div id=\"65f062e2efff42a9bdd6f3931c7a7662\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh active\" style=\"display: flex;\">     <div class=\"tab_txt\">      新页签     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"d1778d9196935cc6129d6ebeee257370\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     新页签    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div class=\"teacher_TabAdd guideBorder\" style=\"display:flex; background-color:rgb(31, 81, 163);\"></div>   </div>   <div class=\"tacherContent\" style=\"\">    <div class=\"addBtn\" style=\"display:flex;\"> <span class=\"iconAdd\"></span>新建主栏目    </div>    <div class=\"tacherContentParts\" style=\"\">     <div id=\"65f062e2efff42a9bdd6f3931c7a7662part\" class=\"part_box\" style=\"display: block;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(71, 85, 98);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em data-editor=\"1\" data-more=\"0\" id=\"3001\">基本信息</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"193cef88b3d1eac32de042737fd39f6d\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"71eb05ed397a84d3d1bab68de4d7e7d1\">           <p style=\"margin-top:4px;margin-right:0;margin-bottom:4px;margin-left:0;text-indent:32px;line-height:27px\"><span style=\"font-size:16px; font-family:times new roman;\"></span></p>           <p style=\"margin: 8px 0px; line-height: 29px; text-indent: 2em;\"><span style=\"font-family:times new roman;\"></span></p>           <p style=\"margin: 8px 0px; line-height: 29px; text-indent: 0em;\"><span style=\"font-size:16px; font-family:华文中宋;\"> 曹政才，男，教授</span><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">/</span><span style=\"font-size:16px; font-family:华文中宋;\">博导，国家级重大人才工程特聘教授（</span><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2022</span><span style=\"font-size:16px; font-family:华文中宋;\">年度）、首都科技领军人才（</span><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2019</span><span style=\"font-size:16px; font-family:华文中宋;\">），北京市高校课程思政教学名师（</span><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2022</span><span style=\"font-size:16px; font-family:华文中宋;\">）、北京市课程思政教学团队负责人（</span><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2022</span><span style=\"font-size:16px; font-family:华文中宋;\">）、团队入选黑龙江省研究生导学思政团队（</span><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2025</span><span style=\"font-size:16px; font-family:华文中宋;\">）。</span></p>           <p style=\"margin: 8px 0px; line-height: 29px; text-indent: 0em;\"><span style=\"font-size:16px; font-family:'Times New Roman',serif;\"> </span><strong><span style=\"font-family:华文中宋;\">科研方面</span></strong><span style=\"font-family:华文中宋;\">：从事智能机器人、人工智能方面的研究工作，近五年主持国家自然基金委重大研究计划重点支持项目、国家重点研发计划课题、北京市自然科学基金等</span><span style=\"\">10</span><span style=\"font-family:华文中宋;\">余项，以第一</span><span style=\"\">/</span><span style=\"font-family:华文中宋;\">通讯在</span><span style=\"\">IEEE</span><span style=\"font-family:华文中宋;\">汇刊发表</span><span style=\"\">30</span><span style=\"font-family:华文中宋;\">余篇，授权国家发明专利</span><span style=\"\">20</span><span style=\"font-family:华文中宋;\">余项，授权软件著作权</span><span style=\"\">10</span><span style=\"font-family:华文中宋;\">余项。荣获高等学校科学研究优秀成果奖（科学技术）自然科学奖</span> <span style=\"font-family:华文中宋;\">二等奖（</span><span style=\"\">2022</span><span style=\"font-family:华文中宋;\">，排名</span><span style=\"\">1</span><span style=\"font-family:华文中宋;\">）、中国自动化学会自然科学奖</span> <span style=\"font-family:华文中宋;\">一等奖（</span><span style=\"\">2020</span><span style=\"font-family:华文中宋;\">，排名</span><span style=\"\">1</span><span style=\"font-family:华文中宋;\">）、机械工业科学技术奖技术发明奖</span> <span style=\"font-family:华文中宋;\">二等奖（</span><span style=\"\">2022</span><span style=\"font-family:华文中宋;\">，排名</span><span style=\"\">1</span><span style=\"font-family:华文中宋;\">）。</span></p>           <p style=\"margin: 8px 0px; line-height: 29px; text-indent: 0em;\"><span style=\"font-size:16px; font-family:'Times New Roman',serif;\"> </span><strong><span style=\"font-family:华文中宋;\">教学方面</span></strong><span style=\"font-family:华文中宋;\">：</span><strong><span style=\"font-family:宋体;\">①</span></strong><span style=\"font-family:华文中宋;\">近五年主持黑龙江省重点、中国机械工业教育协会重点课题等教改项目</span><span style=\"\">5</span><span style=\"font-family:华文中宋;\">项；</span><strong><span style=\"font-family:宋体;\">②</span></strong><span style=\"font-family:华文中宋;\">主讲课程《自动控制原理》入选北京高校</span><span style=\"\">“</span><span style=\"font-family:华文中宋;\">优质本科课程</span><span style=\"\">”</span><span style=\"font-family:华文中宋;\">，《机器人控制技术》入选教育部</span><span style=\"\">“</span><span style=\"font-family:华文中宋;\">拓金计划</span><span style=\"\">”</span><span style=\"font-family:华文中宋;\">和北京市高校课程思政示范课程；</span><strong><span style=\"font-family:宋体;\">③</span></strong><span style=\"font-family:华文中宋;\">主编《自动控制原理》入选黑龙江省“十四五”规划教材、北京高校</span><span style=\"\">“</span><span style=\"font-family:华文中宋;\">优质本科教材</span><span style=\"\">”</span><span style=\"font-family:华文中宋;\">。荣获中国石油和化工教育教学优秀成果</span> <span style=\"font-family:华文中宋;\">特等奖（</span><span style=\"\">2020</span><span style=\"font-family:华文中宋;\">，排</span><span style=\"\">1</span><span style=\"font-family:华文中宋;\">）、北京市高等教育教学成果奖</span> <span style=\"font-family:华文中宋;\">二等奖（</span><span style=\"\">2021</span><span style=\"font-family:华文中宋;\">，排</span><span style=\"\">1</span><span style=\"font-family:华文中宋;\">）、中国自动化学会高等教育教学成果奖</span> <span style=\"font-family:华文中宋;\">二等奖（</span><span style=\"\">2022</span><span style=\"font-family:华文中宋;\">，排</span><span style=\"\">1</span><span style=\"font-family:华文中宋;\">）、</span><span style=\"\">CAAI</span><span style=\"font-family:华文中宋;\">教学成果激励计划二类成果（</span><span style=\"\">2024</span><span style=\"font-family:华文中宋;\">，排</span><span style=\"\">1</span><span style=\"font-family:华文中宋;\">）、中国石油和化工教育教学优秀成果（研究生）二等奖（</span><span style=\"\">2024</span><span style=\"font-family:华文中宋;\">，排</span><span style=\"\">1</span><span style=\"font-family:华文中宋;\">）。</span></p>           <p style=\"margin: 8px 0px; line-height: 29px; text-indent: 2em;\"><span style=\"font-family:times new roman;\"><span style=\"font-family:华文中宋;\"></span></span><br></p>           <p style=\"margin-top:4px;margin-right:0;margin-bottom:4px;margin-left:0;text-indent:32px;line-height:27px\"><span style=\"font-size:16px; padding:0px; font-family:华文中宋;\"><br></span></p>           <p style=\"margin-top:4px;margin-right:0;margin-bottom:4px;margin-left:0;text-indent:32px;line-height:27px\"><span style=\"font-size:16px; font-family:times new roman;\"><br></span></p>           <p><br></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(71, 85, 98);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em id=\"3001\" data-more=\"0\">科研项目</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"cf2761bd96098a0e3602d9da925c2f85\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"7c46a81a5ffefc41f236d8f6f0320876\">           <p style=\"margin-top:4px;margin-right:0;margin-bottom:4px;margin-left:0;line-height:27px\"><strong><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">1. </span></strong><span style=\"font-size:16px; font-family:华文中宋;\"><strong><span style=\"font-size:16px; font-family:华文中宋;\">国家自然科学基金重点项目：</span></strong><span style=\"font-size:16px; font-family:华文中宋;\">类人形化学机器人全流程拟人化自主作业方法研究，<span style=\"font-size:16px; font-family:times new roman;\">2026-2030<span style=\"font-size:16px; font-family:华文中宋;\">，主持</span></span></span></span></p>           <p style=\"margin-top:4px;margin-right:0;margin-bottom:4px;margin-left:0;line-height:27px\"><strong><span style=\"font-size:16px; font-family:times new roman;\">2</span><span style=\"font-size:16px; font-family:华文中宋;\">.<strong><span style=\"font-size:16px; font-family:华文中宋;\"> 国家自然科学基金重大研究计划重点支持项目</span></strong><span style=\"font-size:16px; font-family:华文中宋;\">：大范围陌生室内环境下穿戴式助盲导航机器人关键技术研究</span></span></strong><span style=\"font-size:16px; font-family:华文中宋;\"><span style=\"font-size:16px; font-family:华文中宋;\">，</span><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2022-2025</span><span style=\"font-size:16px; font-family:华文中宋;\">，主持</span></span></p>           <p style=\"margin-top:4px;margin-right:0;margin-bottom:4px;margin-left:0;line-height:27px\"><strong><span style=\"font-size:16px; font-family:times new roman;\">3</span><span style=\"font-size:16px; font-family:华文中宋;\">.</span></strong><span style=\"font-size:16px; font-family:华文中宋;\"><strong><span style=\"font-size:16px; font-family:华文中宋;\">国家自然科学基金-澳门科学技术发展基金联合科研资助项目：</span></strong><span style=\"font-size:16px; font-family:华文中宋;\">需求驱动3C制造车间的分析决策垂类大模型，<span style=\"font-size:16px; font-family:times new roman;\">2026-2028</span><span style=\"font-size:16px; font-family:'Times New Roman',serif;\"></span><span style=\"font-size:16px; font-family:华文中宋;\">，主持</span></span></span></p>           <p style=\"margin-top:4px;margin-right:0;margin-bottom:4px;margin-left:0;line-height:27px\"><strong><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">4. </span></strong><span style=\"font-size:16px; font-family:华文中宋;\"><span style=\"font-size:16px; font-family:华文中宋;\"><strong>国家重点研发计划课题：</strong>面向制造场景的多模态信息感知、知识推理和语义表达，<span style=\"font-size:16px; font-family:times new roman;\">2026-2028</span>，主持<strong><span style=\"font-size:16px; font-family:华文中宋;\"></span></strong></span></span></p>           <p style=\"margin-top:4px;margin-right:0;margin-bottom:4px;margin-left:0;line-height:27px\"><span style=\"font-family:times new roman;\"><strong><span style=\"font-size:16px;\">5</span></strong></span><strong><span style=\"font-size:16px; font-family:华文中宋;\">.</span></strong><strong><span style=\"font-size:16px; font-family:华文中宋;\"> 国家自然科学基金项目</span></strong><span style=\"font-size:16px; font-family:华文中宋;\">：疫情封闭环境下多物流机器人自主协同作业方法，</span><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2022-2025</span><span style=\"font-size:16px; font-family:华文中宋;\">，主持<span style=\"font-size:16px; font-family:华文中宋;\"></span></span><span style=\"font-size:16px; font-family:华文中宋;\"><span style=\"font-size:16px; font-family:华文中宋;\"></span></span></p>           <p><br></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(71, 85, 98);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em id=\"3001\" data-more=\"0\">工作经历</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"13576cdc7e232127dc283cd480ab3562\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"41b5cd730df17ceccdaa3d815d7dd0d0\">           <p style=\"margin: 4px 0px; line-height: 27px; text-indent: 2em;\"><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2024.02<span style=\"\">~</span></span><span style=\"font-size:16px; font-family:华文中宋;\">至今</span> <span style=\"font-size:16px; font-family:华文中宋;\">哈尔滨工业大学</span> <span style=\"font-size:16px; font-family:华文中宋;\">机电工程学院</span> <span style=\"font-size:16px; font-family:华文中宋;\">教授</span></p>           <p style=\"margin: 4px 0px; line-height: 27px; text-indent: 2em;\"><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2020.05~2023.11 </span><span style=\"font-size:16px; font-family:华文中宋;\">北京化工大学</span> <span style=\"font-size:16px; font-family:华文中宋;\">科学技术发展研究院</span> <span style=\"font-size:16px; font-family:华文中宋;\">副院长</span></p>           <p style=\"margin: 4px 0px; line-height: 27px; text-indent: 2em;\"><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2015.09~2020.09 </span><span style=\"font-size:16px; font-family:华文中宋;\">北京化工大学</span> <span style=\"font-size:16px; font-family:华文中宋;\">信息科学与技术学院</span> <span style=\"font-size:16px; font-family:华文中宋;\">副院长</span></p>           <p style=\"margin: 4px 0px; line-height: 27px; text-indent: 2em;\"><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2014.03~2015.03 King's College London </span><span style=\"font-size:16px; font-family:华文中宋;\">访问学者</span></p>           <p style=\"margin: 4px 0px; line-height: 27px; text-indent: 2em;\"><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2008.07~2024.01 </span><span style=\"font-size:16px; font-family:华文中宋;\">北京化工大学</span> <span style=\"font-size:16px; font-family:华文中宋;\">副教授<span style=\"font-family:华文中宋; text-wrap:wrap;\">、</span>教授</span></p>           <p style=\"margin: 4px 0px; line-height: 27px; text-indent: 2em;\"><span style=\"font-size:16px; font-family:'Times New Roman',serif;\">2005.12~2008.07 </span><span style=\"font-size:16px; font-family:华文中宋;\">同济大学</span> <span style=\"font-size:16px; font-family:华文中宋;\">博士后</span></p>           <p><br></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(71, 85, 98);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em id=\"3001\" data-more=\"0\">主要任职</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(