"<html> <head></head> <body>  <div class=\"teacherTabs teacherTabs_view\" id=\"teacherTabs\">   <div id=\"tabb3586\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab\" style=\"display: flex;\">     <div class=\"tab_txt\">      基本信息     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>   <div id=\"bde3e9e250823cff7274a3d3ccbc13c0\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     About Zhu    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"tabb8228\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab\" style=\"display: flex;\">    <div class=\"tab_txt\">     近期动态    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"tabb3587\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab\" style=\"display: flex;\">     <div class=\"tab_txt\">      研究方向     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>   <div id=\"tabb3589\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab\" style=\"display: flex;\">     <div class=\"tab_txt\">      科研成果     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>   <div id=\"tabb9522\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab active\" style=\"display: flex;\">     <div class=\"tab_txt\">      团队成员     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>   <div id=\"8fc743ffbba0711317b513975883c427\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab\" style=\"display: flex;\">    <div class=\"tab_txt\">     师生合影    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"tabb3588\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab\" style=\"display: flex;\">     <div class=\"tab_txt\">      教育教学     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabb9633\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab\" style=\"display: flex;\">     <div class=\"tab_txt\">      科研链接     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div class=\"teacher_TabAdd guideBorder\" style=\"display:flex; background-color:rgb(31, 81, 163);\"></div>   </div>   <div class=\"tacherContent\" style=\"\">    <div class=\"addBtn\" style=\"display:flex;\"> <span class=\"iconAdd\"></span><font> 新建主栏目 </font>   </div>    <div class=\"tacherContentParts\" style=\"\">     <div id=\"tabb3586part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(71, 85, 98);\">         <div class=\"part_t_l\">         <i class=\"title_svg template_icon999\"></i><em id=\"999\" data-more=\"0\">基本信息</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>         <div class=\"part_r\" style=\"\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"83b9018467be4759b2aa5a16764f114d\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"317a9aa990c5404dbedc4262659e914b\">           <p><br></p>           <p class=\"rtejustify\"><span style=\"font-size:16px; font-family:'微软雅黑',sans-serif;\"></span></p>           <table>            <tbody>             <tr>              <td colspan=\"2\" width=\"744.3333333333334\" style=\"word-break:break-all;\"><p class=\"list-paddingleft-2\" style=\"box-sizing:border-box; padding-left:0px; list-style:decimal; color:rgb(0, 0, 0); word-break:normal;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-size:22px;\"></span></p><p style=\"text-indent: 2em;\"><span style=\"color: rgba(0, 0, 0, 0.9); font-family: timesNewRoman; font-size: 20px;\">朱延河</span><span style=\"color: rgba(0, 0, 0, 0.9); font-family: timesNewRoman; font-size: 16px;\"> 机器人技术与系统全国重点实验室副主任，哈尔滨工业大学机电工程学院教授、博士生导师，哈工大人工智能研究院首席科学家。国家自然科学基金A类获得者，国家高层次人才计划。主要研究方向包括模块化自重构机器人、可穿戴机器人、极端环境机器人等，主持国家自然科学基金、国家重点研发计划、国家科技重大专项、核聚变能研究发展专项、载人航天重大工程项目等国家级项目20余项，研究成果成功应用于载人航天、核电运维、抢险救援、医疗康复等领域。发表重要学术论文210余篇，授权国际/中国发明专利120余项，软件著作权10余项，获国家级设计金奖1项，省部级科技奖励一等奖4项。</span></p></td>             </tr>            </tbody>           </table>           <p class=\"rtejustify\"><br></p>           <hr>           <p><strong> </strong></p>           <table border=\"2\" align=\"center\">            <tbody>             <tr>              <td style=\"word-break:break-all;\"><p style=\"text-align:center;\"><br></p><p style=\"text-align:left;\"><strong><a href=\"http://robot.hit.edu.cn/\" target=\"_blank\"><img title=\"\" alt=\"\" src=\"/file/showImg.do?newName=20160906162647_20.jpg&amp;relativePath=/sites/default/files/zhuyanhe/image/&amp;descDir=\" width=\"577\" height=\"150\"></a></strong></p><p style=\"text-align:center;\"><img src=\"/ueditor/jsp/upload/image/20220704/1656925996900018026.jpg\" title=\"1656925996900018026.jpg\" alt=\"图片2.jpg\" width=\"499\" height=\"601\"></p><p style=\"text-align:center;\"><br></p></td>              <td style=\"word-break:break-all;\"><p class=\"rtecenter\"><br></p><p class=\"rtecenter\"><strong> </strong></p><p style=\"\"><strong> 哈尔滨工业大学 </strong></p><p style=\"\"><strong> 机器人技术与系统国家</strong></p><p style=\"\"><strong> 重点实验室 </strong></p><p style=\"\"><strong> 哈工大科学园科创大厦</strong></p><p style=\"\"><strong> K613室</strong></p><p style=\"\"><strong> 南岗区一匡街2号</strong></p><p style=\"\"><strong> 150080 哈尔滨 </strong></p><p class=\"rtecenter\"><br></p><p style=\"margin-top:0px; margin-bottom:0px; padding:0px;\"><span style=\"font-size:12px;\"><strong><a href=\"mailto:yhzhu@hit.edu.cn\" style=\"font-size:14px; text-decoration:underline;\">yhzhu@hit.edu.cn</a></strong></span><br></p><p style=\"margin-top:0px; margin-bottom:0px; padding:0px;\"><span style=\"font-size:14px;\"><strong><a href=\"mailto:zhuyanhe1975@126.com\"><strong>zhuyanhe1975@126.com</strong></a></strong></span></p><p style=\"\"><span style=\"font-size:14px;\"><strong> </strong><br></span></p><p class=\"rtecenter\"><br></p></td>             </tr>            </tbody>           </table>           <hr>           <p><br></p>          </div>          </div> <grammarly-extension-vbars data-grammarly-shadow-root=\"true\" class=\"dnXmp\" style=\"display: contents; --rem: 16;\"></grammarly-extension-vbars><grammarly-extension-vbars data-grammarly-shadow-root=\"true\" class=\"dnXmp\" style=\"display: contents; --rem: 16;\"></grammarly-extension-vbars><grammarly-extension-vbars data-grammarly-shadow-root=\"true\" class=\"dnXmp\" style=\"display: contents; --rem: 16;\"></grammarly-extension-vbars><grammarly-extension-vbars data-grammarly-shadow-root=\"true\" class=\"dnXmp\" style=\"display: contents; --rem: 16;\"></grammarly-extension-vbars>        </ol>        </dl></li>       <li class=\"co