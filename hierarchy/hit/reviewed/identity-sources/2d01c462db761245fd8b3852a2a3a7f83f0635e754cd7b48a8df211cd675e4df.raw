"<html> <head></head> <body>  <div class=\"teacherTabs teacherTabs_view\" id=\"teacherTabs\">   <div id=\"9180ed57012064d47914cf961c386f4d\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab\" style=\"display: flex;\">    <div class=\"tab_txt\">     基本信息    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"515423f7b4e56c87a0ad510cee381458\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">    <div class=\"tab_txt\">     科学研究    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"439dfa6a8ae50c4dc6fe6be9a9a34764\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">    <div class=\"tab_txt\">     教育教学    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"536caa225ca27bf8ea7e39ac28ebe56f\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">    <div class=\"tab_txt\">     学术论文    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"65bb22f41a1c6705e63b34febeabecb0\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh active\" style=\"display: flex;\">    <div class=\"tab_txt\">     招生信息    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"7a9943b6202396982c1fe708fabccacf\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">    <div class=\"tab_txt\">     课题组新闻    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>    <div id=\"2027b0dd6bfec9285a2c34a808ac6b5b\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" data-lang-hidden=\"true\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     Basic Information    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div class=\"teacher_TabAdd guideBorder\" style=\"display:flex; background-color:rgb(31, 81, 163);\"></div>   </div>   <div class=\"tacherContent\" style=\"\">    <div class=\"addBtn\" style=\"display:flex;\"> <span class=\"iconAdd\"></span> 新建主栏目    </div>    <div class=\"tacherContentParts\" style=\"\">     <div id=\"2027b0dd6bfec9285a2c34a808ac6b5bpart\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon999\"></i><em id=\"999\" data-more=\"0\">Contact Details</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"top\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"up\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"down\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"bottom\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"delete\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"64d9d39d726029bcec4b85f171b99d30\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           title          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"5a2a946a2620d0f2cd3a2d10ddfbddce\">           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"><strong>Office:</strong> Room K1707, Technology Innovation Building (TIB), Harbin Institute of Technology</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"><strong>Mobile:</strong> 0451-86413131</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"><strong>Fax:</strong> 0451-86403820</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"><strong>Email:</strong> pgl7782@hit.edu.cn</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"><strong>Mailing Address:</strong> Room K1707, Technology Innovation Building (TIB) , No. 2 Yikuang Street, Nangang District, Harbin, China.</span></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em id=\"3001\" data-more=\"0\">Brief Biography</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"top\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"up\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"down\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"bottom\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"delete\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"8193f37a9a5c273d290c87b800e84a0d\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           title          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"30af9484683a1a8987bdc2674b87f988\">           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Prof. Gaoliang Peng is a Professor and Ph.D. supervisor in the Department of Mechatronic Control and Automation at Harbin Institute of Technology. He is a Changjiang Distinguished Professor of the Ministry of Education, recipient of the Outstanding Youth Science Foundation, and an Elsevier Highly Cited Scholar in China.</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">His research centers on opto-mechatronic integrated equipment and intelligent control systems, with particular emphasis on large-scale radar and directed energy systems. He has spearheaded over 30 major projects, including National Natural Science Foundation Projects, and National Key R&amp;D Programs.</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"> His academic contributions include over 60 SCI-indexed publications (21 in top-tier journals, 4 highly cited papers) with more than 5,600 citations. One was selected among China's 100 Most Influential International Academic Papers. He holds 38 invention patents (6 commercialized) and has received the Second Prize in Natural Sciences of Heilongjiang Province (2018) as the primary investigator.</span></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3101\"></i><em id=\"3101\" data-more=\"0\">Research</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"top\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"up\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"down\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"bottom\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"delete\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"68bcdd8f76047ea433193abba9971928\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           title          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"f9a4114f17d7c677fb8d158b9e268de7\">           <p style=\"line-height: 1.5em; text-indent: 2em;\"><span style=\"\">Prof. Peng is currently accepting Master's and Ph.D. students in Mechatronic Engineering.</span></p>           <p style=\"line-height: 1.5em; text-indent: 2em;\"><span style=\"\">Main research areas of Prof. Peng:</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">● <strong>Design of origami damping structures</strong></span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">The origami-inspired vibration isolator integrated with elastic joints has been investigated. Based on the geomertic configuration of the Tachi–Miura origami carton and the nonlinear stiffness of the elastic joints, the mechanical model of the proposed origami mechanism has been established. Using the obtained nonlinear stiffness characteristics, an origami-inspired vibration isolator with QZS characteristics was developed.</span></p>           <p style=\"line-height: 1.5em; text-indent: 0em; text-align: center;\"><img src=\"/ueditor/jsp/upload/image/20260825/1787648652315028076.jpg\" title=\"1787648652315028076.jpg\" alt=\"11.jpg\"></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"><span style=\"\">● </span><strong>Impact localization of 3D composites based on deep neural networks</strong><strong style=\"text-indent:32px;\"></strong></span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">A two-stage impact identification method for composite cylinder is proposed. For the impact localization task, the circular neighbor negative sample mining strategy and IMS-AAM are proposed in deep networks to make full use of prior information of impact locations without the need to consider the complex mechanical properties of the composite structure. Siamese network with parameter sharing is employed to measure the similarity between training and testing locations, and cosine similarity is utilized as indictor. For the impact time-history reconstruction task, WF-TRTLS is proposed to eliminate the adverse effects of noise and fuse the reconstruction results of several most similar training locations. </span></p>           <p style=\"line-height: 1.5em; text-indent: 0em; text-align: center;\"><img src=\"/ueditor/jsp/upload/image/20260825/1787648714018075564.jpg\" title=\"1787648714018075564.jpg\" alt=\"22.jpg\"></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"><span style=\"\">● </span><strong style=\"text-indent:32px;\">Antenna panel strain estimation based on artificial neural networks</strong></span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">An artificial neural network-based method is presented for estimating element displacements induced by external loads from discrete in situ strain measurements on the surface of an antenna panel and this paper designed a deformation reconstruction model using neural networks and developed a multitask learning loss function based on the assumption of Gaussian loss distribution and homoscedastic uncertainty. </span></p>           <p style=\"line-height: 1.5em; text-indent: 0em; text-align: center;\"><img src=\"/ueditor/jsp/upload/image/20260825/1787648768367020288.jpg\" title=\"1787648768367020288.jpg\" alt=\"33.jpg\"></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"><span style=\"\">● </span><strong style=\"text-indent:32px;\"><span style=\"\">Multi-rate Feedforward Predictive Control method to improve ATP tracking accuracy</span></strong></span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">A multi-rate feedforward predictive control method is proposed that simplifies the system by designing a model-free multi-sample rate controller, facilitating high-ratio expansion of low-frequency data. The approach reduces the number of necessary data predictions and a reduced-order forecast feedforward controller is designed, which is significantly enhance the tracking performance and accuracy of the ATP system while preventing target loss due to excessive speeds.</span></p>           <p style=\"line-height: 1.5em; text-wrap-mode: wrap; text-indent: 0em; text-align: center;\"><img src=\"/ueditor/jsp/upload/image/20260825/1787648787420014765.jpg\" title=\"1787648787420014765.jpg\" alt=\"视觉图片.jpg\"></p>           <p style=\"line-height: 1.5em; text-wrap-mode: wrap; text-indent: 2em;\"><span style=\"\"><span style=\"\">● </span><strong style=\"text-indent:32px;\">Convolutional neural network model for bearing fault diagnosis task</strong></span></p>           <p style=\"line-height: 1.5em; text-wrap-mode: wrap; text-indent: 2em;\"><span style=\"\">A new model named TICNN is proposed, to address the fault diagnosis problem. TICNN works directly on raw vibration signals without any time-consuming hand-crafted feature extraction process. TICNN has two main interferences, first-layer kernel dropout with constantly changing rate and very small batch training. With the help of data augmentation, the proposed TICNN model works well under noisy environment and performs well when the working load changes.</span></p>           <p style=\"line-height: 1.5em; text-wrap-mode: wrap; text-indent: 0em; text-align: center;\"><img src=\"/ueditor/jsp/upload/image/20260825/1787648888823078630.jpg\" title=\"1787648888823078630.jpg\" alt=\"44.jpg\"></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\"><strong><span style=\"\"><span style=\"\">● </span>Acquisition-Tracking-Pointing</span> optoelectronic platform</strong></span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">The ATP (Acquisition, Tracking, and Pointing) consists of a high-precision encoder, a CCD camera, an image processing board, a servo control module, and a driver. The encoder offers positional feedback, while the CCD camera delivers image feedback. The ATP system is driven by a brushless DC motor, and the rotating target is specifically designed to simulate a target exhibiting rapid relative motion, the system employs a stepping motor, capable of simulating various movement targets through the application of different voltages.</span></p>           <p style=\"line-height: 1.5em; text-indent: 0em; text-align: center;\"><img src=\"/ueditor/jsp/upload/image/20260825/1787648937404071881.jpg\" title=\"1787648937404071881.jpg\" alt=\"55.jpg\"></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"text-indent:2em; color:rgb(51, 51, 51); background-color:rgb(255, 255, 255); font-size:16px;\"><strong style=\"text-indent:32px;\">● An improved method for accurate recognition of multi-target motion patterns</strong></span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"text-indent:2em; color:rgb(51, 51, 51); background-color:rgb(255, 255, 255); font-size:16px;\">A multimodel tracking algorithm enhanced with target motion state recognition capabilities has been presented. A Transformer-aided target state recognizer has been integrated, which precisely identifies and models the motion state of targets at each tracking stage. The performance of this multimodel algorithm has been optimized through dynamic adjustments of the motion model and turn rate, based on the recognized state.</span></p>           <p style=\"line-height: 1.5em; text-indent: 0em; text-align: center;\"><img src=\"/ueditor/jsp/upload/image/20260825/1787648954273097320.jpg\" title=\"1787648954273097320.jpg\" alt=\"轨迹预测.jpg\"></p>           <p><br></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon999\"></i><em id=\"999\" data-more=\"0\">Selected Publications</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"top\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"up\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"down\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"bottom\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"delete\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"f5df29e8e9355cff652e118fe6eacfff\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           title          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"0dbaa75c6ec8ca52435ca5521d6419eb\">           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Zhang W, Peng G, Li C, et al. A New Deep Learning Model for Fault Diagnosis with Good Anti-Noise and Domain Adaptation Ability on Raw Vibration Signals[J]. Sensors, 2017, 17(2): 425. 【ESI Highly Cited Paper】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Zhang W, Li C, Peng G, et al. A deep convolutional neural network with new training methods for bearing fault diagnosis under noisy environment and different working load[J]. Mechanical Systems and Signal Processing, 2018, 100: 439-453.【ESI Hot Paper】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Chen Y, Peng G, Zhu Z, et al. A novel deep learning method based on attention mechanism for bearing remaining useful life prediction[J]. Applied Soft Computing, 2020, 86: 105919. 【ESI Highly Cited Paper】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Zhu Z, Peng G, Chen Y, et al. A convolutional neural network based on a capsule network with strong generalization for bearing fault diagnosis[J]. Neurocomputing, 2019, 323: 62-75. 【ESI Highly Cited Paper】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Zhang W, Peng G, Li C. Bearings fault diagnosis based on convolutional neural networks with 2-D representation of vibration signals as input[C]//MATEC Web of Conferences. EDP Sciences, 2017, 95: 13001.</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Chen Y, Peng G, Xie C, et al. ACDIN: Bridging the gap between artificial and real bearing damages for bearing fault diagnosis[J]. Neurocomputing, 2018, 294: 61-71.</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Ji M, Peng G, Li S, et al. A neural network compression method based on knowledge-distillation and parameter quantization for the bearing fault diagnosis[J]. Applied Soft Computing, 2022: 109331.【TOP】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Gaoliang Peng, Zhujun Zhang, Weiquan Li. Computer vision algorithm for measurement and inspection of O-rings. Measurement, Volume 94, December 2016,pp. 828-836.</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Xinhua Liu, Gaoliang Peng, Xiumei Liu and Youfu Hou. Disassembly sequence planning approach for product virtual maintenance based on improved max–min ant system. International Journal of Advanced Manufacturing Technology, 59(5-8), pp 829-839, 2012.</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Liu S, Peng G, Jin K. Design and characteristics of a novel QZS vibration isolation system with origami-inspired corrector[J]. Nonlinear Dynamics, 2021: 1-23.【TOP】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Zhang W, Peng G, Li C. Rolling element bearings fault intelligent diagnosis based on convolutional neural networks using raw sensing signal[M]//Advances in Intelligent Information Hiding and Multimedia Signal Processing. Springer, Cham, 2017: 77-84.</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Liu S, Peng G, Gao H. Dynamic modeling and terminal sliding mode control of a 3-DOF redundantly actuated parallel platform[J]. Mechatronics, 2019, 60: 26-33.</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Li, H., Peng, G., Shan, X., Zhao, M., Zhang, W., Wang, J. and Cheng, F., 2025. Realizing high-speed target tracking by using multi-rate feedforward predictive control for the acquisition, tracking, and pointing system. Defense Technology. 【TOP】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Liu, S., Peng, G., Li, Z., Li, W. and Sun, L., 2023. Low-frequency vibration isolation via an elastic origami-inspired structure. International Journal of Mechanical Sciences, 260, p.108622.【TOP】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Liu, S., Peng, G., Li, Z., Li, W., Jin, K. and Lin, H., 2023. Design and experimental study of an origami-inspired constant-force mechanism. Mechanism and Machine Theory, 179, p.105117.【TOP】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Jiang Y, Huang W, Wang W, Peng G. A complete dynamics model of defective bearings considering the three-dimensional defect area and the spherical cage pocket[J]. Mechanical Systems and Signal Processing, 2023, 185: 109743.【TOP】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Ji M, Peng G, Li S, et al. A neural network compression method based on knowledge-distillation and parameter quantization for the bearing fault diagnosis[J]. Applied Soft Computing, 2022: 109331.【TOP】<br></span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Li S, Peng G, Ji M, et al. Impact identification of composite cylinder based on improved deep metric learning model and weighted fusion Tikhonov regularized total least squares[J]. Composite Structures, 2022, 283: 115144.【TOP】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Liu S, Peng G, Jin K. Towards accurate modeling of the Tachi-Miura origami in vibration isolation platform with geometric nonlinear stiffness and damping[J]. Applied Mathematical Modelling, 2022.【TOP】</span></p>           <p style=\"text-indent: 2em; line-height: 1.5em;\"><span style=\"\">Liu S, Peng G, Jin K. Design and characteristics of a novel QZS vibration isolation system with origami-inspired corrector[J]. Nonlinear Dynamics, 2021: 1-23.【TOP】</span></p>           <p style=\"text-indent: 2em;\"><br></p>          </div>         </div>        </ol>       </dl></li>     </ul>    </div>    <div id=\"9180ed57012064d47914cf961c386f4dpart\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em data-editor=\"1\" data-more=\"0\" id=\"3001\">基本信息</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"3239e523b159b1b4745ed7a32f58d624\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"df703bed7e23c0383f687cf6422a535b\">           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; color:rgb(71, 71, 71); background:white;\"> </span><span style=\"box-sizing:border-box; margin:0px; padding:0px; color:rgb(71, 71, 71); background:white;\"> 彭高亮，男，汉族，1979年出生于湖南岳阳，哈尔滨工业大学机电工程学院/机器人技术与系统国家重点实验室教授/博士生导师。</span>入选教育部高层<span style=\"box-sizing:border-box; margin:0px; padding:0px; color:rgb(71, 71, 71); background:white;\">次人才计划，卓越青年科学基金获得者，Elsevier中国高被引学者。</span></span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; color:rgb(71, 71, 71); background:white; font-family:微软雅黑;\"> 主要从事特种机器人和特种车辆装备技术研究，研究方向包括机器人技术、智能控制与驱动技术、智能传感与监测技术、深度学习技术、数字孪生技术等。主持国家科技重大专项、重大工程项目、国家自然科学基金、国家重点研发计划课题等30余项。以第一/通讯作者发表 SCI 期刊论文90多篇，总引用7200多次，高被引论文4篇，入选中国百篇最具影响力国际学术论文1篇，授权发明专利47项，转化6项。作为第一完成人获部级技术发明一等奖、黑龙江省自然科学二等奖。</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><br></p>           <p><br></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em id=\"3001\" data-more=\"0\">工作经历</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"a507f4941e8da60340fdd84af4f8a4a2\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"468de70d2a3359a8af0092aec3ceab4b\">           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2007-2010 哈尔滨工业大学 机电工程学院 讲师<br></span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2010-2018 哈尔滨工业大学 机电工程学院 副教授</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2013-至今 哈尔滨工业大学 机械电子工程 博士生导师</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2018-至今 哈尔滨工业大学 机电工程学院 教授</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2011-2013 哈尔滨工业大学 机电工程学院 机电控制及自动化系副主任</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2013-2015 哈尔滨工业大学 机电工程学院 院长助理</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2014-2024 哈尔滨工业大学 机电工程学院 机电控制及自动化系主任</span></p>           <p><br></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em id=\"3001\" data-more=\"0\">教育经历</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"feeef5624e25a0684668e6db862e1d6d\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"7f8b0c02a3d5461af9e7c60abee8e83f\">           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">1997-2001 哈尔滨工业大学 机械制造及自动化专业 学士</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2001-2003 哈尔滨工业大学 机械电子工程专业 硕士</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2003-2007 哈尔滨工业大学 航空宇航制造工程专业 博士</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2007-2012 哈尔滨工业大学 生物计算研究中心 博士后</span></p>           <p><br></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em id=\"3001\" data-more=\"0\">奖励与荣誉</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"462e4628c8ad55c15246e461a9dee47d\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"6e42d8f1256607b42d8660960eeb258e\">           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2025年 爱思唯尔（Elsevier）2024“中国高被引学者”</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:宋体, SimSun; text-wrap:wrap;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2025年</span> </span></span><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">入选教育部高层次人才计划（2024年度）</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2024年 黑龙江省高层次人才(B类)</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2023年 爱思唯尔（Elsevier）2023“中国高被引学者”</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2023年 哈工大第二届“育人新星”青年导师</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2023年 哈工大优秀博士论文指导教师（指导教师，博士生：刘世伟）</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2023年 入选国家级高层次人才计划</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2022年 哈尔滨工业大学科技成果突出贡献奖</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2022年 部委技术发明一等奖(1/6)</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2019年 国庆70周年“龙江彩车”工作突出贡献奖</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; text-wrap:wrap;\">2018年 获黑龙江省自然科学二等奖(1/5)</span></p>           <p><br></p>          </div>         </div>        </ol>       </dl></li>     </ul>    </div>    <div id=\"515423f7b4e56c87a0ad510cee381458part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3102\"></i><em data-editor=\"1\" data-more=\"0\" id=\"3102\">团队成员</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"5071136938a5dd07cc53ff3b1ea96f4e\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"d858673b4583050894498476cf543f61\">           <ul class=\"list-paddingleft-2\" style=\"list-style-type:disc;\">            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 2em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">金天国： 副教授， 研究方向： 数字化设计与制造技术、数字孪生技术</span></p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 2em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"></span><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">张旭堂： 副教授， 研究方向： 计算机视觉技术、人工智能技术</span></p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 2em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">刘天辰：副研究员，<span style=\"box-sizing:border-box; margin:0px; padding:0px;\">研究方向：无人系统，优化算法、人工智能技术</span></span></p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 2em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">白相林： 讲 师， 研究方向：工业机器人技术、机电控制技术</span></p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 2em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">李 航：助理研究员，研究方向：光电系统跟瞄控制技术，智能控制技术</span></p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 2em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">程 枫：<span style=\"font-family:微软雅黑;\">助理研究员，研究方向：视觉目标跟踪技术，智能监测技术</span></span></p></li>           </ul>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3101\"></i><em data-editor=\"1\" data-more=\"0\" id=\"3101\">研究领域</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"6ff8793b1a000071d18ed7bd221691e9\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"14e73fdec3a20144619df14bee2ac68f\">           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">在机械电子工程学科、智能科学与技术学科招收硕士研究生和博士研究生。</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">主要研究方向：</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">（1）人工智能：目标识别与跟踪、智能监测与诊断、数字孪生；</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">（2）特种机器人：仿生机构设计、智能感知与决策、智能控制与规划；</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">（3）大型雷达装备：高性能天线设计制造、天线变形感知与调控、分布式雷达系统；</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">（4）光机电一体化装备：目标高效探测、精密跟踪控制、光电跟踪系统；</span></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3101\"></i><em id=\"3101\" data-more=\"0\">承担科研项目</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"8b17c680f2c6f068200cf638660db996\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"0cfab541ab99c94c05897ed00cc4ad5e\">           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑; font-weight:700;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">主持项目如下：</span></span></p>           <ul class=\"list-paddingleft-2\" style=\"list-style-type:disc;\">            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 1.5em;\">国家重点研发计划课题，机器人智能感知-动态规划-安全控制算法及系统组件研究，2022-2025</p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 1.5em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">国家自然科学基金面上项目，大型雷达低速重载轴承早期故障在线智能诊断技术研究，2023-2026</span></p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 1.5em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">国家自然科学基金面上项目，面向复杂服役环境的大型雷达天线自动对接方法与关键技术研究，2019-2022</span></p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 1.5em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">国家自然科学基金面上项目，深井极端工况下机械密封磨损过程的多尺度模拟仿真与预测，2013-2016</span></p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 1.5em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">国家 \"863\"计划，面向野外环境的四足仿生机器人实用技术研发，2015-2017</span></p></li>            <li><p style=\"box-sizing: border-box; padding: 0px; margin-block: 1em; margin: 0px; line-height: 1.5em;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">“高档数控机床与基础制造装备”专项，大型金属壳段快速研制生产线，2016-2018</span></p></li>           </ul>           <p><span style=\"font-family:微软雅黑;\"></span><br></p>          </div>         </div>        </ol>       </dl></li>     </ul>    </div>    <div id=\"439dfa6a8ae50c4dc6fe6be9a9a34764part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3201\"></i><em data-editor=\"1\" data-more=\"0\" id=\"3201\">讲授课程</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"28ab5445b0f54756ca98e023b519b4dc\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"course name\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"5a5c3937bd0a359c112a981b1941a23e\">           <h2 style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">一、本科生专业基础课《机电系统控制基础》</span></span></h2>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">课程编码：</span>SC08100400</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">课程名称：</span>机电系统控制基础</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">课程英文名称： </span>The Control Theory for Electromechanical Systems</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">总学时：</span>58 讲课学时：46 实验学时：12</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">学分：</span>3.5</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">授课对象：</span>机械设计制造及其自动化专业、飞行器制造工程专业本科生</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">开课学期：</span>大三秋季学期</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">先修课程：</span> 电工学、自动控制元件、复变函数和线性代数</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">教材：</span>自编</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">主要参考书：</span></span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">1. 杨叔子.机械工程控制基础. 华中科技大学出版社.2011(第六版).</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2. 董景新. 控制工程基础. 清华大学出版社. 2009 (第三版)</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">课程简介：</span></span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">本课程主要讲授控制理论的基本原理与基本知识及其在机械工程中的应用，以典型机电系统角位置伺服系统为例，贯彻控制系统建模、分析及设计的始终，主要介绍机电系统的数学模型的建立方法、传递函数及结构图；典型一阶、二阶及高阶系统的时域分析；典型环节的频率特性极坐标图、对数坐标图及频率特性的性能指标分析；控制系统的稳定性判据及相对稳定性分析、稳态误差的计算；机电系统的校正方法和装置设计；计算机控制系统的组成、PID离散化方法及改进。</span></p>           <h2 style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 微软雅黑,\"></h2>           <h2 style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">二、本科生创新研修课《多机器人协作探索技术》</span></span></h2>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">课程编码：</span>IR08003100</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">中文名称：</span>多机器人协作探索技术</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">英文名称：</span>Multi-robot cooperation and control technology</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">学 时：</span>20</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">学 分：</span>2</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">授课对象：</span>全校机械类和电控类专业的本科生</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">开课时间：</span>春秋</span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\">课程简介：</span></span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑,;\"></span>多移动机器人系统具有广泛的应用前景, 已成为机器人学的研究热点之一。探索未知环境并建立环境地图，在完成任务中具有准确的定位能力是对高性能多机器人系统的要求，成为近年来多机器人系统研究的重点。这些问题的研究具有许多潜在的应用前景，如危险环境探索、侦察、清扫核废料等。本课程从多机器人的特点与基本原理出发，介绍多机器人技术的研究现状与发展趋势，并重点讲授未知环境下多移动机器人的协作探索实现技术，包括：体系结构、通信与协调机制、路径规划和同时定位与地图构建（SLAM）技术等。在讲授基本理论方法的基础上，开展基于仿真软件平台和实物样机实验系统相结合的实践教学，包括简单结构化未知环境下路径规划与避障算法和快速SLAM算法的编制与测试实践。通过本创新研修课的学习，可使学生对多机器人技术形成系统的认识，掌握多机器人协作探索关键技术，开拓学生的学术视野和创新思维，培养学生跨学科领域思考问题和解决问题的能力。</span></p>           <p><br></p>          </div>         </div>        </ol>       </dl></li>     </ul>    </div>    <div id=\"536caa225ca27bf8ea7e39ac28ebe56fpart\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(32, 68, 115);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3201\"></i><em id=\"3201\" data-more=\"0\">发表论文</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"dd04dbddcebcf1cffa51d13cfd283045\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"course name\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"7270c2c5bf8a6a3ac83942d3a7eca2a0\">           <h1 style=\"box-sizing: border-box; margin: 0px; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">A. 学术论文：<br></span></h1>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; text-align:justify; font-family:Symbol;\"><br></span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; text-align:justify; font-family:Symbol;\"></span></p>           <h2 style=\"text-wrap-mode: wrap; box-sizing: border-box; margin: 5px 0px; padding: 0px;\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; font-family:微软雅黑;\">2026年：</span></h2>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"><span style=\"box-sizing:border-box; margin:0px; padding:0px; text-align:justify; font-family:Symbol;\"></span></p>           <p><span style=\"box-sizing:border-box; margin:0px; padding:0px; text-align:justify; font-family:微软雅黑;\"><span style=\"font-family:Symbol; text-align:justify;\"></span><span style=\"font-family:Symbol; text-align:justify;\">· </span>Wang, Y., Peng, G., Wang, J., Jin, K., &amp; Li, G. (2026). A reconfigurable and generalizable path tracking and stability control method for multi-unit vehicle combinations based on active steering. Transactions of the Institute of Measurement and Control, 01423312261453497.</span></p>           <p><span style=\"box-sizing:border-box; margin:0px; padding:0px; text-align:justify; font-family:微软雅黑;\"><span style=\"font-family:Symbol; text-align:justify;\"></span><span style=\"font-family:Symbol; text-align:justify;\">· </span>Wang, Y., Peng, G., Liu, T., Wang, J., Chen, Z., Jin, K., &amp; Li, H. (2026). Multi-level Estimation Framework of Articulated Vehicle Sideslip Angles via Data-Model Fusion. IEEE Sensors Journal</span></p>           <p><span style=\"box-sizing:border-box; margin:0px; padding:0px; text-align:justify; font-family:微软雅黑;\"><span style=\"font-family:Symbol; text-align:justify;\"></span><span style=\"font-family:Symbol; text-align:justify;\">· </span>Ma, Q., Liu, T., Cheng, F., Li, H., Zhang, W., &amp; Peng, G. (2026, July). DynaFill-MCPSO: Dynamic Adaptive Gas-Solid-Phase Flow Filling Control via Multi-swarm Cellular PSO with Agent-Based Optimization. In 2026 IEEE/ASME International Conference on Advanced Intelligent Mechatronics (AIM) (pp. 1-6). </span></p>           <p><span style=\"box-sizing:border-box; margin:0px; padding:0px; text-align:justify; font-family:微软雅黑;\"><span style=\"font-family:Symbol; text-align:justify;\"></span><span style=\"font-family:Symbol; text-align:justify;\">· </span>Ma, Q., Liu, T., Wang, L., Li, L., Peng, G., &amp; Li, H. (2026, April). DPG-RF: An Adaptive Recognition Method Based on Discriminative-Power-Guided Random Forest for Gas-Solid Two-Phase Flow Carriers. In 2026 6th International Conference on Artificial Intelligence and Industrial Technology Applications (AIITA) (pp. 884-888). </span></p>           <p style=\"box-sizing: border-box; padding: 0px; font-family: 微软雅黑,\"></p>           <p><s