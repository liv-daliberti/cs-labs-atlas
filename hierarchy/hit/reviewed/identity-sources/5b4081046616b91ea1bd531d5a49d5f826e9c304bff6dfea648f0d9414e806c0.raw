 data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           Whispers 2013, Florida, U.S.          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2015-08-07          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"426dab04b1a4463cbe42a98340fdb75b\">            <p></p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=P1060679.JPG&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"> </p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=2013_whispers_florida.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=P1060580.JPG&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p>http://core-ieee.whispers.com</p>            <p></p>           </div>          </div>         </ol>         <ol id=\"de74a713ce3043338b82da27103c57b0\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           ICIP 2014, Paris, France          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2014-12-25          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"a36bb16b619c4c2e9c2717265f2dd900\">            <p></p>            <p><a href=\"http://icip2014.wp.mines-telecom.fr\"></a><img alt=\"\" src=\"/file/showImg.do?newName=20141030_140937_0.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"> <img alt=\"\" src=\"/file/showImg.do?newName=20141030_142257.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p> </p>            <p><a href=\"http://icip2014.wp.mines-telecom.fr\"></a>http://icip2014.wp.mines-telecom.fr/</p>            <p></p>           </div>          </div>         </ol>         <ol id=\"9c02a79f383345a6ab40978d19635d39\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           Congratulations to Professor Yu          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2014-11-30          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"49ce9a0d7758497087ccd62a5d5490cf\">            <p></p>            <p><a href=\"http://newscenter.berkeley.edu/2014/04/29/five-faculty-members-elected-to-national-academy-of-sciences\"></a>http://newscenter.berkeley.edu/2014/04/29/five-faculty-members-elected-to-national-academy-of-sciences/</p>            <p></p>           </div>          </div>         </ol>         <ol id=\"e87c19ff3642452cadcf0ccbc88d31d0\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           MultiTemp 2015          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2015-08-01          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"93a9396a3ad947a583a6b8a461f22141\">            <p></p>            <p>http://www.multitemp2015.org/</p>            <p> </p>            <p>Poster 展示</p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=multitemp2015-p1_0.jpeg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p></p>           </div>          </div>         </ol>         <ol id=\"894640146d18405c9b23de47d54b6b3e\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           荣获 IEEE TGRS Best Reviewers in 2015          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2016-03-16          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"3c5d3197779846b9a5994c3a6be55f51\">            <p></p>            <div>             Dear Prof. Gu,            </div>            <div>            </div>            <div>             Each year, the Editorial Board of the IEEE Transactions on Geoscience            </div>            <div>             and Remote Sensing (TGRS) recognizes its best anonymous peer reviewers.            </div>            <div>             All Associate Editors on the Editorial Board are invited to nominate            </div>            <div>             candidates for this recognition based on the reviews they have managed            </div>            <div>             over the past year. From that list of nominees, five reviewers were            </div>            <div>             selected (in no specific order) to be recognized as the Best TGRS            </div>            <div>             Reviewers in 2015.            </div>            <div>            </div>            <div>             I am very happy to report that you have been selected (and ratified by            </div>            <div>             our Society's Administrative Committee) as one of the five Best 2015            </div>            <div>             TGRS Reviewers. I offer you my sincerest congratulations and thanks for            </div>            <div>             the excellent service you have provided to our society and its members.            </div>            <div>             The quality of TGRS could not possibly be maintained without the            </div>            <div>             considerable help of reviewers like you. With your approval, we would            </div>            <div>             like to acknowledge this distinction in several ways.            </div>            <div>            </div>            <div>             1) Attached to this e-mail you can already find a formal letter about            </div>            <div>             this recognition. Please do not hesitate to let me know if you would            </div>            <div>             like me to change any details in your affiliation and/or contact details.            </div>            <div>            </div>            <div>             2) An announcement of the award is planned for publication in the IEEE            </div>            <div>             Geoscience and Remote Sensing Magazine. We would like to include a            </div>            <div>             picture of each of the Best TGRS Reviewers. Could you please send me a            </div>            <div>             suitable photo and also include your full name and institutional            </div>            <div>             affiliation as you would like it to appear in the announcement?            </div>            <div>            </div>            <div>             3) There is an Editors Luncheon hosted by the Geoscience and Remote            </div>            <div>             Sensing Society each year at the IGARSS conference, to which all Editors            </div>            <div>             and Associate Editors are invited. It is a chance to meet informally and            </div>            <div>             discuss the journal and the review process, and for me to give the other            </div>            <div>             Editors a status report and get feedback from them. If you are planning            </div>            <div>             to attend IGARSS this summer (in Beijing, China, on July 10-15, 2016)            </div>            <div>             you are invited to join us for this luncheon. Please kindly let me know            </div>            <div>             about your availability. If you can attend, we also hope that you might            </div>            <div>             be willing to share your impressions and suggestions with us about the            </div>            <div>             peer review process from your perspective. The luncheon is still not            </div>            <div>             scheduled but I will let you know about the date, time and location of            </div>            <div>             the luncheon as soon as these details are available.            </div>            <div>            </div>            <div>             Once again, congratulations and thank you for your dedicated service. I            </div>            <div>             look forward to hearing back from you soon.            </div>            <div>            </div>            <div>             All the best,            </div>            <div>            </div>            <div>             Antonio            </div>            <div>            </div>            <div>             --            </div>            <div>             Prof. Antonio J. Plaza            </div>            <div>             IEEE Fellow            </div>            <div>             Editor-in-Chief, IEEE Transactions on Geoscience and Remote Sensing            </div>            <div>             Head of the Hyperspectral Computing Laboratory (HyperComp)            </div>            <div>             Department of Technology of Computers and Communications            </div>            <div>             Escuela Politécnica de Cáceres, University of Extremadura            </div>            <div>             Avda. de la Universidad s/n, E-10003 Cáceres, SPAIN            </div>            <div>             Phone: +34 927 257000 (Dial extension 51662 during voice message)            </div>            <div>             Website (personal):<span class=\"Apple-converted-space\"> </span><a href=\"http://www.umbc.edu/rssipl/people/aplaza\">http://www.umbc.edu/rssipl/people/aplaza</a>            </div>            <div>             Website (lab):<span class=\"Apple-converted-space\"> </span><a href=\"http://www.hypercomp.es\">http://www.hypercomp.es</a>            </div>            <div>             E-mail: aplaza@unex.es            </div>            <p></p>           </div>          </div>         </ol>         <ol id=\"ea1205e76622410fabbc9788c82dab10\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           祝贺王青旺同学获得本科校优秀论文          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2015-01-07          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"b6ededa72dfe4a42a215bf7072bf6535\">            <p></p>            <p><span>论文方向：高光谱与激光雷达联合分类</span></p>            <p> </p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=20150106_182134.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p></p>           </div>          </div>         </ol>         <ol id=\"214f2101dc8e40309e230d956c9c26f4\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           祝贺王玉亭、王青旺两位同学ICIP论文录取          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2014-11-30          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls