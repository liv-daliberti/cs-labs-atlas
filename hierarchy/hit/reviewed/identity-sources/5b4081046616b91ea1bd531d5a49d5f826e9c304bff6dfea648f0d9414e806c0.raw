"<html> <head></head> <body>  <div class=\"teacherTabs teacherTabs_view\" id=\"teacherTabs\">    <div id=\"tabb9955\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh active\" style=\"display: flex;\">    <div class=\"tab_txt\">     基本信息    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>    <div id=\"tabb9957\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">    <div class=\"tab_txt\">     科学研究    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>    <div id=\"a7530e3f97acca3e949ed204e4466b2e\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab\" style=\"display: flex;\">    <div class=\"tab_txt\">     成果展示    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>    <div id=\"tabb9959\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">    <div class=\"tab_txt\">     人才培养    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>    <div id=\"tabb9961\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">    <div class=\"tab_txt\">     学术活动    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>    <div id=\"40fb3b455561829c8b8264797a79422c\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     Basic Information新页签    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"f31e0eaa9d21d8bc7228f4cc1223078c\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     Scientific Research新页签    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div class=\"teacher_TabAdd guideBorder\" style=\"display:flex; background-color:rgb(31, 81, 163);\"></div>   </div>   <div class=\"tacherContent\" style=\"\">    <div class=\"addBtn\" style=\"display:flex;\"> <span class=\"iconAdd\"></span> 新建主栏目    </div>    <div class=\"tacherContentParts\" style=\"\">     <div id=\"tabb9955part\" class=\"part_box\" style=\"display: block;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3001\"></i><em id=\"3001\" data-more=\"0\">个人情况</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"19a6429dc913972bf6df7e9f7f46c1dc\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"b3f95def70355ce65dc986280147d54a\">           <p style=\"line-height: 2em;\"><strong><span style=\"font-family:微软雅黑;\">职称职务</span></strong><span style=\"font-family:微软雅黑;\">：<span style=\"font-family:微软雅黑;\">哈尔滨工业大学电子与信息工程学院副院长，二级教授，博士生导师</span></span></p>           <p style=\"line-height: 2em;\"><strong><span style=\"font-family:微软雅黑;\">研究方向</span></strong><span style=\"font-family:微软雅黑;\">：空间智能遥感，智能体与具身智能，高光谱，光电探测与信号处理系统</span></p>           <p style=\"line-height: 2em;\"><strong><span style=\"font-family:微软雅黑;\">荣誉称号</span></strong><span style=\"font-family:微软雅黑;\">：</span><span style=\"font-family:微软雅黑; text-decoration:none;\">国家杰青，国家级高层次人才入选者，科技部中青年科技创新领军人才</span></p>           <p style=\"line-height: 2em;\"><strong><span style=\"font-family:微软雅黑;\">学术任职</span></strong><span style=\"font-family:微软雅黑;\">：中国遥感应用协会理事，黑龙江省天空地一体化智能遥感技术重点实验室主任，IEEE地球科学与遥感汇刊Associate Editor、《中国科学：技术科学》编委、《中国图象图形学报》编委、《系统工程与电子技术》编委等</span></p>           <p style=\"line-height: 2em;\"><strong><span style=\"font-family:微软雅黑;\">科研项目</span></strong><span style=\"font-family:微软雅黑;\">：主持国家自然科学基金委重点国际合作项目、重大科学仪器研制项目，国家部委重点项目课题等</span></p>           <p style=\"line-height: 2em;\"><strong><span style=\"font-family:微软雅黑;\">科技奖励</span></strong><span style=\"font-family:微软雅黑;\">：第一完成人获中国电子学会自然科学一等奖，黑龙江省自然科学一等奖，省部级科技进步二等奖等科技奖励。</span><br></p>          </div>         </div>        </ol>       </dl></li>       <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3102\"></i><em data-editor=\"1\" data-more=\"0\" id=\"3102\">团队成员</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"5bfe1a49d3ef34de9cf8c584b5ddd3f4\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"0c97cc2eeaac7d71e6b284e391b95815\">           <p>主要成员：<br></p>           <p><br></p>           <p>刘天竹，国家级青年人才（基金委 青B // 优青），研究员（<span style=\"\">青年拔尖</span>），博导<br></p>           <p><a href=\"https://homepage.hit.edu.cn/liutianzhu\">https://homepage.hit.edu.cn/liutianzhu</a> </p>           <p><br></p>           <p style=\"text-wrap-mode: wrap\">官大衍，国家级海外青年人才，副教授/博导</p>           <p style=\"text-wrap-mode: wrap\"><a href=\"http://homepage.hit.edu.cn/guandayan?lang=zh\">http://homepage.hit.edu.cn/guandayan</a></p>           <p style=\"text-wrap-mode: wrap\"><br></p>           <p style=\"text-wrap-mode: wrap\">肖傲然，国家级海外青年人才，教授/博导</p>           <p style=\"text-wrap-mode: wrap\"><a href=\"http://homepage.hit.edu.cn/xiaoaoran\">http://homepage.hit.edu.cn/xiaoaoran</a> </p>           <p style=\"text-wrap-mode: wrap\"><br></p>           <p>高国明，副研究员/博导</p>           <p><a href=\"http://homepage.hit.edu.cn/gaoguoming?lang=zh\">http://homepage.hit.edu.cn/gaoguoming</a></p>           <p style=\"text-wrap-mode: wrap\"><br></p>           <p style=\"text-wrap-mode: wrap\">李 贤，博士后副研究员/硕导（省优青）<br></p>           <p style=\"text-wrap-mode: wrap;\"><a href=\"http://homepage.hit.edu.cn/XianLi\">http://homepage.hit.edu.cn/XianLi</a></p>           <p style=\"text-wrap-mode: wrap;\"><br></p>           <p style=\"text-wrap-mode: wrap;\">董 喆，博士后</p>           <p style=\"text-wrap-mode: wrap;\"><br></p>          </div>         </div>        </ol>       </dl></li>      <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">招生信息</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"a6bf74d690bb44d8923af2a383e84729\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"92b28959f7b842938a069ebed9e54d60\">           <p><span style=\"font-size:20px;\"><strong><span style=\"color:rgb(255, 0, 0); font-family:微软雅黑;\">欢迎2026-2027级硕、博研究生报考！</span></strong></span></p>           <p><br></p>           <p style=\"line-height: 2em;\"><strong><span style=\"\">招生类型</span></strong><span style=\"\">：硕士统考、推免，博士申请考核、直博；</span></p>           <p style=\"line-height: 2em;\"><strong>招生数量</strong>：每年招收博士生8-10人、硕士生10-15人，博士后1-2人；</p>           <p style=\"line-height: 2em;\"><strong>研究方向</strong>：<strong>人工智能与遥感交叉领域</strong>、<strong>低空经济信息技术赋能领域</strong>相关方向；</p>           <p style=\"line-height: 2em;\"><strong>助研待遇</strong>：在基本助研津贴(按国家标准)基础上，额外发放激励津贴(按实际工作成效，1k~5k)；<br></p>           <p style=\"line-height: 2em;\"><strong>毕业去向</strong>：高校，国家重点领域企业，科研机构，领军民企。</p>          </div>          </div>         </ol>        </dl></li>      </ul>     </div>     <div id=\"tabb9957part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">研究领域</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"3225904b08ae4d99b144fe26c6c11141\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"502af033250e4be2a2965ec28acab957\">           <p style=\"line-height: 2em;\">主要研究方向:</p>           <ul class=\"list-paddingleft-2\">            <li><p style=\"line-height: 2em;\"><strong>空天信息处理</strong>(Aerospace information processing)</p><p style=\"line-height: 2em;\">聚焦航天、航空/低空领域典型场景目标检测识别、地物分类、变化检测等任务，开展前沿理论方法研究</p></li>            <li><p style=\"line-height: 2em;\"><strong>多模态遥感大模型</strong>(Multimodal Remote Sensing Foundation Model)</p><p style=\"line-height: 2em;\">基于空-天-地平台高时间、高空间、高光谱分辨率海量数据，开展空天探测多模态、电磁多谱段、融合大语言模型的多模态遥感基础模型理论方法、轻量化、端侧部署研究</p></li>            <li><p style=\"line-height: 2em;\"><strong>多模高光谱遥感探测与处理</strong>(Multimodal Hyperspectral Remote Sensing Detection &amp; Processing)</p><p style=\"line-height: 2em;\">以高光谱探测为核心，开展小型化新体制高光谱探测系统研制、光谱智能感知理论与方法、多模高光谱信息处理系统研究</p></li>           </ul>           <p><br></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">招生信息</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"bfdac860704b42e4bbd7e8fd0a0f4963\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"2e2fd985585d4aadb90d46dcbf57960e\">           <p><br></p>           <p>秉承：教学相长，因材施教，兴趣并努力同行。</p>           <p><br></p>           <p>团队每年招生博士生6-8人，硕士生6-10人</p>           <ul class=\"list-paddingleft-2\">            <li><p>遥感大数据智能处理</p></li>            <li><p>多模高光谱遥感智能探测</p></li>           </ul>           <p>欢迎有志于科学研究的同学们报考！</p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>      </ul>     </div>     <div id=\"tabb9959part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">团队成员</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"37c2e69b1a7c4fe7a94c6bed16bc534e\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"07c419b7c12b48dca7904bbf39dd5a39\">            <p></p>            <table border=\"1\" align=\"center\">             <tbody>              <tr>               <td colspan=\"3\"><strong>博士生 2010-2014</strong></td>              </tr>              <tr>               <td>曹志民</td>               <td><img alt=\"\" src=\"/file/showImg.do?newName=2010Cao.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></td>               <td>合理规划，勤奋钻研，付出定有回报</td>              </tr>              <tr>               <td> </td>               <td> </td>               <td> </td>              </tr>              <tr>               <td>高国明</td>               <td><img alt=\"\" src=\"/file/showImg.do?newName=2013Gao.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></td>               <td>知识如浩瀚宇宙，只有深入，没有彼岸</td>              </tr>              <tr>               <td> </td>               <td> </td>               <td> </td>              </tr>              <tr>               <td>刘天竹</td>               <td><img alt=\"\" src=\"/file/showImg.do?newName=2014LiuTZ.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></td>               <td>努力，只是为了体验更大的世界</td>              </tr>              <tr>               <td> </td>               <td> </td>               <td> </td>              </tr>              <tr>               <td>李大林</td>               <td> </td>               <td> </td>              </tr>              <tr>               <td> </td>               <td> </td>               <td> </td>              </tr>              <tr>               <td colspan=\"3\"><strong>硕士生 </strong><strong>2013-2015</strong></td>              </tr>              <tr>               <td>王玉亭</td>               <td><img alt=\"\" src=\"/file/showImg.do?newName=2013WangYT.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></td>               <td>不要让明天的你讨厌现在的自己</td>              </tr>              <tr>               <td> </td>               <td> </td>               <td> </td>              </tr>              <tr>               <td>王青旺</td>               <td><img alt=\"\" src=\"/file/showImg.do?newName=2014WangQW.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></td>               <td>读万卷书，行万里路</td>              </tr>              <tr>               <td> </td>               <td> </td>               <td> </td>              </tr>              <tr>               <td>解冰谦</td>               <td><img alt=\"\" src=\"/file/showImg.do?newName=2014XieBQ.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></td>               <td>自制力！规划力！执行力！</td>              </tr>              <tr>               <td> </td>               <td> </td>               <td> </td>              </tr>              <tr>               <td>王彤</td>               <td><img alt=\"\" src=\"/file/showImg.do?newName=2014WangT.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></td>               <td>越努力，越幸运!</td>              </tr>              <tr>               <td> </td>               <td> </td>               <td> </td>              </tr>              <tr>               <td>刘永健</td>               <td><img alt=\"\" src=\"/file/showImg.do?newName=IMG_2172.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></td>               <td>无悔的人生要用努力来创造</td>              </tr>              <tr>               <td> </td>               <td> </td>               <td> </td>              </tr>              <tr>               <td>刘欢</td>               <td><img alt=\"\" src=\"/file/showImg.do?newName=2015LiuH.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></td>               <td>古之立大事者，不惟有超世之才，亦必有坚忍不拔之志</td>              </tr>              <tr>               <td colspan=\"3\"> </td>              </tr>              <tr>               <td><strong>毕业学生</strong></td>               <td><p><strong>2009届：刘星</strong></p><p><strong>2010届：韩景龙，黄顺欢</strong></p><p><strong>2011届：王晨(加拿大阿尔伯塔大学读博)，王建凯，刘保学</strong></p><p><strong>2012届：王师哲，于潇，李斯琼(加拿大多伦多大学读研)，左德山</strong></p><p><strong>2013届：丰炳波，冯凯，崔兆宇(美国罗切斯特理工大学读博)</strong></p><p><strong>2014届：王宏，郑贺</strong></p></td>               <td> </td>              </tr>             </tbody>            </table>            <p> </p>            <p></p>           </div>          </div>         </ol>        </dl></li>      </ul>     </div>     <div id=\"tabb9961part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon3401\"></i><em data-editor=\"1\" data-more=\"1\" id=\"3401\">Academic Activities</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_icon_add\" title=\"新增\"><i class=\"part_icon1 part_icon_add\" style=\"display:flex;\"></i></a><i class=\"part_icon_solid\"></i><a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"2c089b9e48e04ddebf5107ee3ef5455a\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           Whispers 2013, Florida, U.S.          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2015-08-07          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"123b4bb4fa9f4f89ad018fc6b0154cc8\">            <p></p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=P1060679.JPG&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"> </p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=2013_whispers_florida.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=P1060580.JPG&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p>http://core-ieee.whispers.com</p>            <p></p>           </div>          </div>         </ol>         <ol id=\"4324e5c51b6547169fdae037e674a68f\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           ICIP 2014, Paris, France          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2014-12-25          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"63d46f8df57646479c3291023b51e882\">            <p></p>            <p><a href=\"http://icip2014.wp.mines-telecom.fr\"></a><img alt=\"\" src=\"/file/showImg.do?newName=20141030_140937_0.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"> <img alt=\"\" src=\"/file/showImg.do?newName=20141030_142257.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p> </p>            <p><a href=\"http://icip2014.wp.mines-telecom.fr\"></a>http://icip2014.wp.mines-telecom.fr/</p>            <p></p>           </div>          </div>         </ol>         <ol id=\"21096e9f55024a50ad9981acd494e5a4\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           Congratulations to Professor Yu          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2014-11-30          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"7e6440aff76f4421b1141f10c5f67227\">            <p></p>            <p><a href=\"http://newscenter.berkeley.edu/2014/04/29/five-faculty-members-elected-to-national-academy-of-sciences\"></a>http://newscenter.berkeley.edu/2014/04/29/five-faculty-members-elected-to-national-academy-of-sciences/</p>            <p></p>           </div>          </div>         </ol>         <ol id=\"a2f8aeca89004f8abbfcff31fc78e7a2\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           MultiTemp 2015          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2015-08-01          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"184467c6584446329452269c75741d06\">            <p></p>            <p>http://www.multitemp2015.org/</p>            <p> </p>            <p>Poster 展示</p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=multitemp2015-p1_0.jpeg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p></p>           </div>          </div>         </ol>         <ol id=\"2a844fb794f143fd9ed9c076bba4682d\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           荣获 IEEE TGRS Best Reviewers in 2015          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2016-03-16          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"e2ff3b281b154283b1bedc1b18bec98a\">            <p></p>            <div>             Dear Prof. Gu,            </div>            <div>            </div>            <div>             Each year, the Editorial Board of the IEEE Transactions on Geoscience            </div>            <div>             and Remote Sensing (TGRS) recognizes its best anonymous peer reviewers.            </div>            <div>             All Associate Editors on the Editorial Board are invited to nominate            </div>            <div>             candidates for this recognition based on the reviews they have managed            </div>            <div>             over the past year. From that list of nominees, five reviewers were            </div>            <div>             selected (in no specific order) to be recognized as the Best TGRS            </div>            <div>             Reviewers in 2015.            </div>            <div>            </div>            <div>             I am very happy to report that you have been selected (and ratified by            </div>            <div>             our Society's Administrative Committee) as one of the five Best 2015            </div>            <div>             TGRS Reviewers. I offer you my sincerest congratulations and thanks for            </div>            <div>             the excellent service you have provided to our society and its members.            </div>            <div>             The quality of TGRS could not possibly be maintained without the            </div>            <div>             considerable help of reviewers like you. With your approval, we would            </div>            <div>             like to acknowledge this distinction in several ways.            </div>            <div>            </div>            <div>             1) Attached to this e-mail you can already find a formal letter about            </div>            <div>             this recognition. Please do not hesitate to let me know if you would            </div>            <div>             like me to change any details in your affiliation and/or contact details.            </div>            <div>            </div>            <div>             2) An announcement of the award is planned for publication in the IEEE            </div>            <div>             Geoscience and Remote Sensing Magazine. We would like to include a            </div>            <div>             picture of each of the Best TGRS Reviewers. Could you please send me a            </div>            <div>             suitable photo and also include your full name and institutional            </div>            <div>             affiliation as you would like it to appear in the announcement?            </div>            <div>            </div>            <div>             3) There is an Editors Luncheon hosted by the Geoscience and Remote            </div>            <div>             Sensing Society each year at the IGARSS conference, to which all Editors            </div>            <div>             and Associate Editors are invited. It is a chance to meet informally and            </div>            <div>             discuss the journal and the review process, and for me to give the other            </div>            <div>             Editors a status report and get feedback from them. If you are planning            </div>            <div>             to attend IGARSS this summer (in Beijing, China, on July 10-15, 2016)            </div>            <div>             you are invited to join us for this luncheon. Please kindly let me know            </div>            <div>             about your availability. If you can attend, we also hope that you might            </div>            <div>             be willing to share your impressions and suggestions with us about the            </div>            <div>             peer review process from your perspective. The luncheon is still not            </div>            <div>             scheduled but I will let you know about the date, time and location of            </div>            <div>             the luncheon as soon as these details are available.            </div>            <div>            </div>            <div>             Once again, congratulations and thank you for your dedicated service. I            </div>            <div>             look forward to hearing back from you soon.            </div>            <div>            </div>            <div>             All the best,            </div>            <div>            </div>            <div>             Antonio            </div>            <div>            </div>            <div>             --            </div>            <div>             Prof. Antonio J. Plaza            </div>            <div>             IEEE Fellow            </div>            <div>             Editor-in-Chief, IEEE Transactions on Geoscience and Remote Sensing            </div>            <div>             Head of the Hyperspectral Computing Laboratory (HyperComp)            </div>            <div>             Department of Technology of Computers and Communications            </div>            <div>             Escuela Politécnica de Cáceres, University of Extremadura            </div>            <div>             Avda. de la Universidad s/n, E-10003 Cáceres, SPAIN            </div>            <div>             Phone: +34 927 257000 (Dial extension 51662 during voice message)            </div>            <div>             Website (personal):<span class=\"Apple-converted-space\"> </span><a href=\"http://www.umbc.edu/rssipl/people/aplaza\">http://www.umbc.edu/rssipl/people/aplaza</a>            </div>            <div>             Website (lab):<span class=\"Apple-converted-space\"> </span><a href=\"http://www.hypercomp.es\">http://www.hypercomp.es</a>            </div>            <div>             E-mail: aplaza@unex.es            </div>            <p></p>           </div>          </div>         </ol>         <ol id=\"b89409f1ce4f45fdb55b8af62e542cec\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"新闻标题\" data-zh=\"新闻标题\">            新闻标题           </div>           <div class=\"ol_value\">           祝贺王青旺同学获得本科校优秀论文          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"发布时间\" data-zh=\"发布时间\">            发布时间           </div>           <div class=\"ol_value\">           2015-01-07          </div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content editor_Hidden editor_contentHidden\" id=\"b177f60ce8de48bda6a0ffdb2ab8adba\">            <p></p>            <p><span>论文方向：高光谱与激光雷达联合分类</span></p>            <p> </p>            <p><img alt=\"\" src=\"/file/showImg.do?newName=20150106_182134.jpg&amp;relativePath=/sites/default/files/guyf/&amp;descDir=\"></p>            <p></p>           </div>          </div>         </ol>         <ol id=\"48bec80aeb1647319b8d48bad07d718f\" style=\"padding-left: 70px;\">          <div class=\"card_view\" d