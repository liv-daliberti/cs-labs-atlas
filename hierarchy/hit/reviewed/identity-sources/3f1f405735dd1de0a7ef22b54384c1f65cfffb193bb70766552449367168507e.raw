"<html> <head></head> <body>  <div class=\"teacherTabs teacherTabs_view\" id=\"teacherTabs\">   <div id=\"fdcc84f8d6e180256bbf0173cc5da83a\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en active\" style=\"display: flex;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     English Version    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display: block; background-color: rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>    <div id=\"tabb7997\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      基本信息     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display: block; background-color: rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabb7998\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      科学研究     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display: block; background-color: rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabb7999\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      教育教学     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display: block; background-color: rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabb8000\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      论文专著     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display: block; background-color: rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"taba349d6ea15bc08a3566ec109780c7806\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      诚招博士后     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display: block; background-color: rgb(31, 81, 163);\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div class=\"teacher_TabAdd guideBorder\" style=\"display: flex; background-color: rgb(31, 81, 163);\"></div>   </div>   <div class=\"tacherContent\" style=\"\">    <div class=\"addBtn\" style=\"display: flex;\"> <span class=\"iconAdd\"></span> 新建主栏目    </div>    <div class=\"tacherContentParts\" style=\"\">     <div id=\"tabb7997part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">基本信息</em><i class=\"part_icon part_icon_e1\" style=\"display: flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display: flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display: flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display: flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display: flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display: flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"fb90de65750a42f0bb0037269c18c08f\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display: none;\">           <div class=\"editor_content\" id=\"741d103d9a00488c9d84716721b68d4b\">           <p style=\"line-height: 1.5em;\">郭继峰，男，汉族，工学博士，教授，博士生导师，哈尔滨工业大学航天学院副院长。</p>           <p style=\"line-height: 1.5em;\">长期从事航天器系统技术、空间在轨服务技术、无人系统技术等基础理论与工程技术研究，担任国家级科技计划专家组专家，中国宇航学会、中国空间科学学会专业委员会委员，《宇航学报》、《无人系统技术》、《航天控制》、《指挥与控制学报》编委。主持承担国家级科技计划项目50余项，获国家级、省部级科技奖励2项，出版学术专著2部，发表论文50余篇，授权发明专利40余项。</p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">荣誉称号</em><i class=\"part_icon part_icon_e1\" style=\"display: flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display: flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display: flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display: flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display: flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display: flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"584edc88e85243e19279306266e9428e\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display: none;\">           <div class=\"editor_content\" id=\"ffcd4f826cec42d189e3968deb6f3d42\">           <p>2023年获哈尔滨工业大学“突出专家贡献奖”；</p>           <p>2023年获《宇航学报》优秀青年编委；</p>           <p>2022年获哈尔滨工业大学“突出专家贡献奖”；</p>           <p>2018年获国家级研究生教育成果一等奖；</p>           <p>2013年获黑龙江省高等教育教学成果二等奖；</p>           <p>2013年获黑龙江省高校师德先进个人；</p>           <p>2013年获哈尔滨工业大学教学新秀奖；</p>           <p>2012年获哈尔滨工业大学教学成果一等奖；</p>           <p>2012年获SHATF奖教金一等奖；</p>           <p>2012年度荣获哈尔滨工业大学航天学院学科建设“突出贡献奖”；</p>           <p>2010-2011年度哈尔滨工业大学先进工作者。</p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">工作经历</em><i class=\"part_icon part_icon_e1\" style=\"display: flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display: flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display: flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display: flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display: flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display: flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"f3c9566d212d41028cff24d11eade4e4\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display: none;\">           <div class=\"editor_content\" id=\"898e283d350a4791a7588172a5ce457e\">           <p>2007.9至今，哈尔滨工业大学航天学院航天工程系分别任讲师、硕士生导师、副教授、博士生导师、教授。<br></p>           <p><br></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">教育经历</em><i class=\"part_icon part_icon_e1\" style=\"display: flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display: flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display: flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display: flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display: flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display: flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"75e6715587ff4bfebf80983287fb9fec\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display: none;\">           <div class=\"editor_content\" id=\"b5531510af9846aea32ed42912251e7e\">           <p>1997.7-2007.7 哈尔滨工业大学航天学院航空宇航科学与技术学科攻读本科、硕士、博士学位。<br></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">主要任职</em><i class=\"part_icon part_icon_e1\" style=\"display: flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display: flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display: flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display: flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display: flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display: flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"2f2ecd5c540c4cb0ae08620688d2fc01\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display: none;\">           <div class=\"editor_content\" id=\"71eb6b9e1998434ca695622dd5c4d201\">           <p>2018.6至今，哈尔滨工业大学航天学院任副院长；<br></p>           <p>2012.1至2018.6，哈尔滨工业大学航天学院航天工程系任副主任。</p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>      </ul>     </div>     <div id=\"tabb7998part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(116, 110, 111);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon3105\"></i><em data-editor=\"0\" data-more=\"1\" id=\"3105\">科研项目</em><i class=\"part_icon part_icon_e1\" style=\"display: flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_icon_add\" title=\"新增\"><i class=\"part_icon1 part_icon_add\" style=\"display: flex;\"></i></a><i class=\"part_icon_solid\"></i><a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display: flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display: flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display: flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display: flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display: flex;\"></i></a>         </div>        </div>        <dl>         <ol id=\"da012204c24c423c92bff286fc949edf\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display: none;\">           <div class=\"model_title\" data-en=\"项目名称\" data-zh=\"项目名称\">            项目名称           </div>           <div class=\"ol_value\">           利用基于采样的规划方法解决自主在轨服务航天器复杂模型运动规划问题          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display: none;\">           <div class=\"model_title\" data-en=\"项目来源\" data-zh=\"项目来源\">            项目来源           </div>           <div class=\"ol_value\">           国家自然科学基金          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display: none;\">           <div class=\"model_title\" data-en=\"开始时间\" data-zh=\"开始时间\">            开始时间           </div>           <div class=\"ol_value\">           2011-01-01          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display: none;\">           <div class=\"model_title\" data-en=\"结束时间\" data-zh=\"结束时间\">            结束时间           </div>           <div class=\"ol_value\">           2013-12-01          </div>          </div>          <div class=\"card_view\" data-olname=\"\" data-domtype=\"input\" style=\"display: none;\">           <div class=\"model_title\" data-en=\"项目经费\" data-zh=\"项目经费\">            项目经费           </div>           <div class=\"ol_value\">           21   