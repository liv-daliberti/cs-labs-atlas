"<html> <head></head> <body>  <div class=\"teacherTabs\" id=\"teacherTabs\">    <div id=\"tabb8302\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh active\" style=\"display: flex;\">     <div class=\"tab_txt\">      基本信息     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabb8303\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      科学研究     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"tabb8304\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">    <div class=\"tab_txt\">     教育教学    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>    <div id=\"tabb8305\" data-show=\"1\" data-languageflag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      论文专著     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"4c4cb2f587d6289bae96089cd64f6531\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     Basic Information    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"a512a5b7b0377fcf77a43ec32b05f0c8\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     Scientific Research新页签    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"50e276a187d88a87ae651265af2fe5f7\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     Teaching    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div id=\"1ea385500b8add09c7f9a091cec559f3\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     Publications    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div class=\"teacher_TabAdd guideBorder\" style=\"display:flex; background-color:rgb(31, 81, 163);\"></div>   </div>   <div class=\"tacherContent\" style=\"\">    <div class=\"addBtn\" style=\"display:flex;\"> <span class=\"iconAdd\"></span> 新建主栏目    </div>    <div class=\"tacherContentParts\" style=\"\">     <div id=\"tabb8302part\" class=\"part_box\" style=\"display: block;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(87, 122, 149);\">         <div class=\"part_t_l\">         <i class=\"title_svg template_icon999\"></i><em id=\"999\" data-more=\"0\">简介信息</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>         <div class=\"part_r\" style=\"\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"c9f60f449aff42098590ac7746684761\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"f48f094a2fd1422fa9823ac34e447154\">           <p><br></p>           <p><br></p>           <p style=\"text-indent:32px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">查富生，男，1974年生。教授，博士生导师，主要从事人工智能、足式机器人、视觉SLAM、移动作业机器人等研究。</span></p>           <p style=\"text-indent:32px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">近五年主持工信部人形机器人揭榜挂帅项目、国家自然科学基金重大项目子课题等国家级项目七项；参与自然基金创新集群、工信部高质量专项、重点研发计划等国家级项目九项，承担科研经费5000余万元。</span></p>           <p style=\"text-indent:32px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">出版专著1部，发表论文100余篇，其中SCI检索50余篇、EI检索40余篇；授权国家发明专利20余项；获得黑龙江省科技技术一、二等奖各1项，黑龙江省科技进步二等奖1项。</span></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>      <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(87, 122, 149);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">教育经历</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"2e9494915f3d421f90acff9d052fe44f\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"b64542fc362648d294c0b0b2d4141892\">           <p style=\"margin-left:48px;line-height:20px\"><span style=\"font-family:宋体, SimSun; font-size:16px;\">2005.03 — 2012.06哈尔滨工业大学 机械电子工程 博士</span></p>           <p style=\"margin-left:48px;line-height:20px\"><span style=\"font-family:宋体, SimSun; font-size:16px;\">2002.09 — 2005.03兰州理工大学 机械设计及理论 硕士</span></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>      <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(87, 122, 149);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">工作经历</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"d67ea1d0f46d4ce7b7b0ab86bb4d5710\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"fd05e955af41454b8bf65591b665be3c\">           <p style=\"margin-left:48px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">2024.12 — 至今哈尔滨工业大学机电工程学院 教授</span></p>           <p style=\"margin-left:48px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">2016.12 — 2024.12哈尔滨工业大学机电工程学院 副教授（2020.07 博导）</span></p>           <p style=\"margin-left:48px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">2009.01 — 2016.12哈尔滨工业大学机电工程学院 讲师</span></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>      </ul>     </div>     <div id=\"tabb8303part\" class=\"part_box\" style=\"display: none;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">      <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(87, 122, 149);\">         <div class=\"part_t_l\">         <i class=\"title_svg template_icon999\"></i><em id=\"999\" data-more=\"0\">主要研究方向</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"9039937628d243d3b794eed2fa577ff0\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"f1c72d7a24354f1f8e28b818366cb586\">           <p><br></p>           <p style=\"margin-left:48px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">1、仿生与具身智能系统</span></p>           <p style=\"line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">足式机器人（人形、四足、六足机器人）、高动态仿生控制系统与复杂环境自适应运动控制等。</span></p>           <p style=\"margin-left:48px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">2、具身视觉与自主感知决策</span></p>           <p style=\"line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">异构多机器人协同路径规划、视觉感知与导航建图、视觉语言导航等。</span></p>           <p style=\"margin-left:48px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">3、仿人作业与自主操作</span></p>           <p style=\"line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">移动作业机器人、仿人抓取与直觉物理操作决策、双臂协同操作等。</span></p>           <p style=\"margin-left:48px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">4、水下机器人技术与应用</span></p>           <p style=\"line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">水下自主目标识别与位姿估计、水下机械臂控制、无人潜航器动-动对接等。</span></p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>      <li class=\"con_parts\" style=\"display:block;\">       <div class=\"part_t\" style=\"background-color:rgb(87, 122, 149);\">        <div class=\"part_t_l\">         <i class=\"title_svg template_icon3101\"></i><em id=\"3101\" data-more=\"0\">科研项目</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>        </div>        <div class=\"part_r\">         <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>        </div>       </div>       <dl style=\"\">        <ol id=\"822805bdc8b332d93d29f22c87a15dfe\" style=\"padding-left: 70px;\">         <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">          <div class=\"model_title\" data-en=\"title\" data-zh=\"名称\">           名称          </div>          <div class=\"ol_value\"></div>         </div>         <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">          <div class=\"editor_content\" id=\"eeeb64eb78952cfa8d4e0d5b950436b4\">           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">1、主持国家级科技创新项目，2018.12-2020.12，项目经费350万元；</span></p>           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">2、主持仿生感知、学习、作业及多机器人智能协同关键技术课题（国家自然科学基金联合基金）<span style=\"font-size:16px; font-family:等线;\">，2021.01-2024.12，项目经费215.8万元；</span></span></p>           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">3、主持人形机器人控制技术攻关（23年度“揭榜挂帅”苏州培育重大项目）<span style=\"font-size:16px; font-family:等线;\">，2023.09-2026.09，项目经费</span>250万元；</span></p>           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">4<span style=\"font-size:16px; font-family:等线;\">、主持人形机器人运动控制算法研发及测试验证，2024.01-2024.12，项目经费220万元；</span></span></p>           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">5、主持面向人形机器人高动态运动的全身动力学控制算法（<span style=\"font-size:16px; font-family:等线;\">工信部2023\"揭榜挂帅\"</span>）<span style=\"font-size:16px; font-family:等线;\">，2024.01-2025.12，项目经费2300万元；</span></span></p>           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">6<span style=\"font-size:16px; font-family:等线;\">、主持六足特种机器人原型机设计与开发，2025.04-2027.04，项目经费600万元；</span></span></p>           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">7、主持神经调节的人形机器人高动态运动小脑实时控制技术研发（苏州市科技攻关项目/苏州市关键核心技术项目），2025.07-2028.06，项目经费100万；</span></p>           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">8、主持铝电解槽槽内衬关键扎固工艺与配套智能装备研发（国家级示范区科技发展计划）<span style=\"font-size:16px; font-family:等线;\">，2026.04-2028.04，项目经费</span>135万元；</span></p>           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">9、主持面向半封闭立体分段应用场景的具身智能焊接机器人工况感知、运动精度控制及工艺自主决策研究（“揭榜挂帅”科技创新项目），2026.07-2027.12，项目经费150万；</span></p>           <p style=\"margin-left:24px;line-height:20px\"><span style=\"font-size:16px; font-family:宋体, SimSun;\">10、参与国家自然科学基金项目创新研究群体项目——机器人基础理论与关键技术，2016.01-2021.12，项目经费1200万元。</span></p>           <p><br></p>          </div>         </div>        </ol>       </dl