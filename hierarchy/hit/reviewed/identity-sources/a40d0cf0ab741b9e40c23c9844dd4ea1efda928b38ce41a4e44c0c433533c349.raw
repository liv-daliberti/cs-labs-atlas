flag=\"zh\" class=\"teacher_Tab teacher_Tab_zh\" style=\"display: flex;\">     <div class=\"tab_txt\">      论文专著     </div>     <div class=\"tab_showHide\" style=\"display:flex;\"> <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>     </div>    </div>    <div id=\"048a91a4ac0a8203ead8374ba520d2e2\" data-show=\"1\" data-languageflag=\"en\" class=\"teacher_Tab teacher_Tab_en\" style=\"display: none;\">    <div class=\"enImage\"></div>    <div class=\"tab_txt\">     新页签    </div>    <div class=\"tab_showHide\" style=\"display:flex;\">     <i class=\"tab_show\" onclick=\"tabShow(this)\" style=\"display:block; background-color:#1F51A3;\"></i><i class=\"tab_hide\" onclick=\"tabHide(this)\" style=\"display:none; background-color:#1F51A3;\"></i>    </div>   </div>   <div class=\"teacher_TabAdd\" style=\"display:flex; background-color:#1F51A3;\"></div>   </div>   <div class=\"tacherContent\" style=\"\">    <div class=\"addBtn\" style=\"display:flex;\"> <span class=\"iconAdd\"></span> 新建主栏目    </div>    <div class=\"tacherContentParts\" style=\"\">     <div id=\"tabb5940part\" class=\"part_box\" style=\"display: block;\">      <ul class=\"tacherContent_parts\" id=\"tacherContent_parts\" style=\"\">       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(87, 122, 149);\">         <div class=\"part_t_l\"> <i class=\"title_svg template_icon999\"></i><em data-editor=\"1\" data-more=\"0\" id=\"999\">基本信息</em><i class=\"part_icon part_icon_e1\" style=\"display:flex;\"></i>         </div>         <div class=\"part_r\"> <a id=\"part_card_top\" onclick=\"part_card_top(this)\" title=\"置顶\"><i class=\"part_icon1 part_icon_top\" style=\"display:flex;\"></i></a><a id=\"part_card_up\" onclick=\"part_card_up(this)\" title=\"上移\"><i class=\"part_icon1 part_icon_up\" style=\"display:flex;\"></i></a><a id=\"part_card_down\" onclick=\"part_card_down(this)\" title=\"下移\"><i class=\"part_icon1 part_icon_down\" style=\"display:flex;\"></i></a><a id=\"part_card_bottom\" onclick=\"part_card_bottom(this)\" title=\"置底\"><i class=\"part_icon1 part_icon_bottom\" style=\"display:flex;\"></i></a><a id=\"part_icon_d\" title=\"删除\"><i class=\"part_icon1 part_icon_d\" style=\"display:flex;\"></i></a>         </div>        </div>        <dl style=\"\">         <ol id=\"cc94a119f06242a4aecc6d39fc01b49b\" style=\"padding-left: 70px;\">          <div class=\"card_view\" data-olname=\"olName\" data-domtype=\"input\" style=\"display:none;\">           <div class=\"model_title\" data-en=\"名称\" data-zh=\"名称\">            名称           </div>           <div class=\"ol_value\"></div>          </div>          <div class=\"card_view\" data-domtype=\"editor_controls\" style=\"display:none;\">           <div class=\"editor_content\" id=\"cb3303b2097946ac9b438c68efd4b127\">           <p><br></p>           <p style=\"margin-top:5px;margin-right:0;margin-bottom:5px;margin-left: 0;line-height:16px\">倪风雷，研究员，博士生导师，国家高层次人才计划入选者。</p>           <p style=\"margin-top:5px;margin-right:0;margin-bottom:5px;margin-left: 0;line-height:16px\"><br></p>           <p style=\"margin-top:5px;margin-right:0;margin-bottom:5px;margin-left: 0;line-height:16px\"><br></p>           <p style=\"margin: 5px 0px; text-align: justify; line-height: 1.5em;\">研究方向空间机器人/人形机器人的智能驱动与灵巧操作控制技术。</p><span style=\"text-align:justify;\">主持国家部委、国家自然科学基金、921三期/四期以及863项目等课题20余项。</span>           <p style=\"margin: 5px 0px; text-align: justify; line-height: 1.5em;\">发表SCI/EI论文70余篇，授权国家发明专利20余项。</p>           <p style=\"margin: 5px 0px; text-align: justify; line-height: 1.5em;\">获国家技术发明二等奖2项（1项排3，1项排6）。</p>           <p><br></p>          </div>          </div>         </ol>        </dl></li>       <li class=\"con_parts\" style=\"display:block;\">        <div class=\"part_t\" style=\"background-color:rgb(87, 122, 149);\">