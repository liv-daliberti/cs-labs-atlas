<!DOCTYPE html><html><head>    <meta charset="UTF-8">    <meta http-equiv="content-type" content="text/html;charset=utf-8">    <meta http-equiv="X-UA-Compatible" content="IE=edge, chrome=1" />    <meta name="renderer" content="webkit" />    <meta name="viewport"        content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no" />    <meta name="format-detection" content="telephone=no" />    <meta name="keywords" content="PERSONAL HOMEPAGE OF HIT, Wu Ligang, 国家杰青、国家级高层次人才" />    <meta name="description"        content="PERSONAL HOMEPAGE OF HIT, Wu Ligang, 国家杰青、国家级高层次人才, School of Astronautics, , " />    <title>Ligang Wu - PERSONAL HOMEPAGE OF HIT </title>    <link rel="shortcut icon" href="favicon.ico">    <link href="https://cdn.bootcss.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet">    <link href="inside-network/bootstrap.min.css" rel="stylesheet">    <link rel="stylesheet" type="text/css" href="style/jquery.guide.css" />    <link href="https://cdn.bootcss.com/sweetalert/1.1.3/sweetalert.min.css" rel="stylesheet">    <link href="inside-network/sweetalert.min.css" rel="stylesheet">    <link href="https://cdn.bootcss.com/cropper/3.1.4/cropper.css" rel="stylesheet">    <link href="inside-network/cropper.css" rel="stylesheet">    <link rel="stylesheet" type="text/css" href="style/homepage/header-footer.css" />    <link rel="stylesheet" type="text/css" href="style/home-teacher-show.css" />    <link rel="stylesheet" type="text/css" href="style/style-3qi.css" />    <link rel="stylesheet" type="text/css" href="style/skin-3qi.css" />    <link rel="stylesheet" type="text/css" href="style/template-default0.css" />    <style>        .m-per .tips em {            background-color: #577a95;        }               .m-per .tips em::after{            /* border-right: 8px solid #577a95; */        }        .header .row1 .wp,        .Buoy_tools .Buoy_tools_icon,        .Buoy_tools .Buoy_tools_text,        #teacherTabs .teacher_Tab.active,        #teacherTabs .teacher_Tab,        .submitTips,        .teacherTabs_util:nth-child(1){            background-color: #577a95!important;        }        .user-country{            background-color: #D3AB51;        }        .submitTips .submitTips_btn,        .m-con .tit-g h3,        .m-con .ul-cont em {            color: #577a95!important;        }        #teacherTabs .teacher_Tab:hover {            background: #577a95!important;            box-shadow: 0px 2px 11px 2px #577a95;        }        /* .home,        #logout,        #adminPanel,        #log,        #pulldown,        #log1,        #logout1,        #home1,        #adminPanel1,        .eng {            background: #577a95!important;        } */        .right a{            background: #2f4352!important;        }        .theme-fcolor {            color: #577a95;        }        .theme-bcolor {            color: #2f4352;        }        ul#myTab {            background-color: #577a95!important;        }        .bg-primary {            background-color: #2f4352;        }        ul#myTab li {            background-color: #577a95;        }        .footer .f1_bg {            width: 100%;            height: 100%;            opacity: 0.8;            position: absolute;            top: 0;            left: 0;            z-index: 0;            background-color: #577a95!important;        }                .footer .f1 dt {          border-color: #577a95!important;        }        .footer .f2 {            background-color: #2f4352!important;        }        .d-two span,        .cur .teac,        .part2 em,        .m-per .part4 li .link,        .m-per .part4 li .copy,        .m-con .ul-cont em {            color: #2f4352!important;        }        .m-per .part4 li em {            color: #fff;        }        .ul#myTab li.active {            background: #0075F5 !important;            color: #fff !important;        }        ul#myTab li.active {            background: #0075F5 !important;            box-shadow: 0px 2px 11px 2px rgba(19, 110, 211, 0.4);            border-radius: 4px;        }        .m-con .tit-g {}        .m-per .part3 em,        .m-con .tit-g h3,        .suspendbox .name,        #myTabContent .lv1 .lv1-header {            color: #474747 !important;        }        .d-two .d2 span {            color: #f6a041 !important;        }        .srch1 {            background-color: #e1e1e1 !important;        }        .srch1 .two-input .input2,        .srch5 .start {            background-color: #2f4352!important;        }        .srch1 .number .txt em {            color: #577a95!important;        }        .gundong-btn {            width: 5%;            padding: 13px 0px 18px;            background: #2f4352;            border-top:2px solid #577a95;            border-bottom:2px solid #577a95;            font-size:16px;            cursor:pointer;            color:#ffffff;        }        .gundong-btn:hover {            background: #577a95;        }        .gundong-btn:active {            background: #2f4352;        }        div.user-left-title>div.row {            background-color: #577a95;            height:60px;        }        .m-per {}        .user-position,.user-discipline{  max-width: 160px;  display: -webkit-box;  overflow: hidden;  white-space: normal!important;  text-overflow: ellipsis;  word-wrap: break-word;  -webkit-line-clamp: 1;  -webkit-box-orient: vertical}.user-label{  max-width: 150px;  display: -webkit-box;  overflow: hidden;  white-space: normal!important;  text-overflow: ellipsis;  word-wrap: break-word;  -webkit-line-clamp: 1;  -webkit-box-orient: vertical}    </style></head><body>    <!-- 顶部是读取其它html页面出来的，别乱动 -->    <div class="header">        <div class="row1"></div>        <div class="banner">            <div class="item">                <img src="file/showImg.do?newName=8904156280723.jpg&relativePath=2018-03-06&descDir=fnewsUpload" alt="">            </div>        </div>               <!-- 个人信息 -->        <div class="m-per" id="teacher_info">            <div class="wp part2_1_box">                <div class="part1 part">                    <div class="pic user-img">                        <img class="img-thumbnail" src="images/defult-login-img.jpg"                            data-src="file/showHP.do?d=264&&w=200&&h=204" />                    </div>                </div>                <div class="part2_1">                	<div class="backgroundColor"></div>                    <h3 class="tit englishName">                        <span id="firstName">Ligang</span>&nbsp;                        <span id="lastName">Wu</span>                    </h3>                    <em style="height:25px;line-height: 23px;" class="user-country ">China</em>                </div>                <div class="tips">                    <em class="user-post"></em>                    <div style="display: none;" id="teacher-honor">Doctoral Supervisor </div>                    <!-- <em class="user-honor" data-honor="" ></em> -->                </div>                            </div>            <div class="wp" style="border-bottom:1px solid #ddd">                <div class="part2 part">                    <p>                        <span class="user-describe" title="国家杰青、国家级高层次人才"></span>                    </p>                </div>                <div class="part4 part">                    <ul>                        <li>                            <em>Department</em>                            <span class="user-position" title="School of Astronautics">School of Astronautics</span>                            <a href="school-dept?id=1&browseName=校内单位&browseEnName=UNIT&deptName=000001"                                class="link"></a>                        </li>                        <li>                            <em>Subject</em>                            <span class="user-discipline" title=""></span>                        </li>                        <li>                            <em>Research</em>                            <span class="user-label" title=""></span>                        </li>                        <!-- <li>                        <em>URL</em>                        <a href="/wuligang" class="web"><span                                class="user-url">http://homepage.hit.edu.cn/wuligang</span></a>                        <a href="javascript:void(0);" class="copy btnCopy">copy</a>                    </li> -->                    </ul>                </div>            </div>        </div>        <div class="row2">            <div class="wp">                <ul class="ul-info">                    <li class="d-two">                        <div class="d1 d">                            <i></i>                            <em>update</em>                            <!-- <span id="tModifyDate">2025-10-23</span> -->                            <span id="tModifyDate"></span>                        </div>                        <div class="d2 d">                            <i></i>                            <em>popularity</em>                            <span id="visitNo"></span>                        </div>                        <div class="d2 d">                            <em>url</em>                            <a href="wuligang" class="web">                                <span class="user-url">http://homepage.hit.edu.cn/wuligang</span>                            </a>                            <a href="javascript:void(0);" class="copy btnCopy">copy</a>                        </div>                    </li>                    <li>                        <div class="so1">                            <div class="soInputBox">                                <input type="text" class="so_input" placeholder="search key">                                <i class="i1"></i>                            </div>                            <!-- <a href="javascript:void(0);" class="js-moreso11">教师检索</a> -->                        </div>                    </li>                </ul>            </div>        </div>        <div class="public-header" style="height: 78px; background: rgb(41, 49, 127); display: none;">            <a href="/">                <img class="public-header-logo"                    src="file/showImg.do?newName=2450222791137141.png&amp;relativePath=2018-06-28&amp;descDir=LOGO3"                    style="display: inline;">            </a>            <!-- 中英切换 -->            <button class="btn btn-default pull-right public-header-language" style="margin-top: 22px;">ZH</button>            <!-- 退出 -->            <button class="btn btn-danger pull-right public-header-exit"                style="margin-top: 22px; display: inline-block;">                <span class="glyphicon glyphicon-log-out" aria-hidden="true"></span>            </button>            <!-- 后台管理 -->            <!-- <button class="btn btn-default pull-right public-header-system"                style="margin-top: 22px; display: inline-block;">                <span class="glyphicon glyphicon-cog" aria-hidden="true"></span>            </button> -->            <!-- 我的主页 -->            <button class="btn btn-default pull-right public-header-my" style="margin-top: 22px; display: none;">                <span class="glyphicon glyphicon-user" aria-hidden="true"></span>            </button>            <!-- 登录 -->            <button class="btn btn-default pull-right public-header-login" style="margin-top: 22px; display: none;">                <span title="登录" class="glyphicon glyphicon-user" aria-hidden="true"></span>            </button>            <!-- 搜索 -->            <div class="pull-right col-xs-2.1 public-header-search" style="display: block;">                <input type="text" class="form-control" placeholder="Name, college, subject, label">            </div>        </div>    </div>    <!-- 搜索区 -->    <div class="m-srch" id="sSearchPart">    </div>    	 <!-- 版本号显示区 --> <div class="versionInfo" style="display:none"> 	<div id="version"></div> 	&nbsp;&nbsp;&nbsp;&nbsp; 	<div id="status"></div> </div> 	<!-- 浮标工具区 -->	<div class="Buoy_tools" >	   <div class="changeSkin Buoy_tools_btn" style="display: none;">	       <span class="Buoy_tools_icon"><i></i></span>	       <span class="Buoy_tools_text" data-txt="更换皮肤" onclick="BuoyToolsClick(this)">Skin</span>	   </div>	   <div class="compose Buoy_tools_btn" style="display: none;">	       <span class="Buoy_tools_icon"><i></i></span>	       <span class="Buoy_tools_text" data-txt="版式" onclick="BuoyToolsClick(this)">Layout</span>	   </div>	   <div class="preview Buoy_tools_btn" style="display: none;">	       <span class="Buoy_tools_icon edit"><i ></i></span>	       <span class="Buoy_tools_icon view"><i ></i></span>	       <span class="Buoy_tools_text" onclick="BuoyToolsClick(this)" data-txt="预览">Preview</span>	   </div>	   <div class="feedback Buoy_tools_btn" style="display: none;">	      <span class="Buoy_tools_icon"><i></i></span>	      <span class="Buoy_tools_text" data-txt="意见反馈" onclick="BuoyToolsClick(this)">Opinion</span>        <div class="qrcodeShow" id="qrcodeShow_yj">            <div class="qr">              <img width="145px" height="203px" src="images/qr-new.jpg" >            </div>        </div>     </div>	   <div class="qrcodeView Buoy_tools_btn">	       <span class="Buoy_tools_icon"><i></i></span>	       <span class="Buoy_tools_text" data-txt="二维码" onclick="BuoyToolsClick(this)">QR code</span>	        <div class="qrcodeShow" id="qrcodeShow">	            <div class="qr">	                <div class="pic" id="qr"></div>	                <p>Scan QR code</p>	                <p>Visit the mobile version</p>	            </div> 	        </div>	    </div>	   <div class="scrollTop Buoy_tools_btn">	       <span class="Buoy_tools_icon"><i></i></span>	       <span class="Buoy_tools_text" data-txt="回到顶部" onclick="BuoyToolsClick(this)">Top</span>	   </div>	</div>    <!-- 内容区 -->    <div class="home-teacher container-fluid"        style="min-height: calc(100% - 160px); background: url('file/showImg.do?newName=8891299956935.jpg&relativePath=2018-03-06&descDir=newsUpload') 0% 0% / 100% no-repeat;">        <div class="m-con">            <div class="wp  user-main">                <!-- 左侧信息 -->                <div class="col-l teacher-body" data-tid="264">                </div>                <!-- 右侧信息 -->                <div class="col-r">                    <!-- 联系方式 -->                    <div class="cont">                        <div class="tit-g">                            <h3>Contact</h3>                        </div>                        <ul class="ul-cont">                            <li class="addr">                                <em><span class="glyphicon glyphicon-phone-alt"></span>Tel</em>                                <div class="txt">                                    <p>0451-86403518</p>                                </div>                            </li>                            <li class="addr">                                <em><span class="glyphicon glyphicon-print"></span>Fax</em>                                <div class="txt">                                    <p>0451-86403518</p>                                </div>                            </li>                            <li class="addr">                                <em><span class="glyphicon glyphicon-print"></span>Email</em>                                <div class="txt">                                    <p class="EmailText">nc.ude.tih@uwgnagil</p>                                </div>                            </li>                            <li class="addr">                                <em><span class="glyphicon glyphicon-home"></span>Adr</em>                                <div class="txt">                                    <p></p>                                </div>                            </li>                        </ul>                        <div class="tit-g" id="shnt01">                            <h3>Scholar Network</h3>                        </div>                        <ul class="ul-ico" id="shnt02">                            <li><a href="http://xueshu.baidu.com" target="black"><img src="file/showImg.do?newName=579633040812346.png&relativePath=2018-11-02&descDir=MEDIA"  alt="baidu" title="http://xueshu.baidu.com"></a></li><li><a href="http://www.researcherid.com/rid/K-2922-2012" target="black"><img src="file/showImg.do?newName=579601079207227.png&relativePath=2018-11-02&descDir=MEDIA"  alt="reseacherID" title="http://www.researcherid.com/rid/K-2922-2012"></a></li>                        </ul>                    </div>                    <!-- 相关教师 -->                    <div class="ateac">                        <div class="tit-g">                            <a href="javascript:void(0);" onclick="queryAllForUserByPage()" class="re"></a>                            <h3>Related</h3>                        </div>                        <!--学院-->                        <div class="change-list-dept"></div>                        <div class="col-xs-12 home-title" id="change-dept"></div>                        <!--学科-->                        <div class="change-list-subject"></div>                        <div class="col-xs-12 home-title" id="change-subject"></div>                        <!--研究方向-->                        <div class="change-list-label"></div>                        <div class="col-xs-12 home-title" id="change-label"></div>                    </div>                                  </div>            </div>        </div>    </div>    <div class="footer"></div>    <script type="text/javascript" charset="utf-8" src="inside-network/jquery.min.js"></script>    <script type="text/javascript" charset="utf-8" src="inside-network/bootstrap.min.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/jquery-qrcode-0.14.0.min.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/global.js" charset="utf-8"></script>    <script type="text/javascript" charset="utf-8" src="scripts/cropper.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/lib.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/homepage/header-footer.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/utils/newUtils.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/homepage/home-teacher-show.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/commons.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/base.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/clipboard.min.js"></script>    <script type="text/javascript" charset="utf-8" src="scripts/utils/htmlUtils.js"></script>    <script type="text/javascript" charset="utf-8">        var clipboard = new ClipboardJS('.btnCopy', {            text: function () {                return 'http://homepage.hit.edu.cn/wuligang';            }        });        clipboard.on('success', function (e) {            alert('复制成功');        });        clipboard.on('error', function (e) {            alert('复制失败');        });    </script></body></html>s