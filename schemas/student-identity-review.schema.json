{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "hierarchy/student-identity-review.json",
 "description": "Within-lab record verdicts and source-bound cross-lab person identity reviews. The ID builder validates the exact membership and primary-source proofs before joining.",
 "x-file": "hierarchy/student-identity-review.json",
 "x-kind": "reviewed",
 "x-writer": "hand-reviewed (same-name research)",
 "x-readers": [
  "tools/pi_hierarchy.py (tools/pihier/students.py identity_review)",
  "tools/chain_audit.py"
 ],
 "x-rules": [
  "R-STU-04"
 ],
 "type": "array",
 "items": {
  "description": "A verdict.",
  "type": "object",
  "properties": {
   "school": {
    "description": "School key.",
    "type": "string",
    "pattern": "^[a-z]+$"
   },
   "pi": {
    "description": "The lab.",
    "type": "string"
   },
   "a": {
    "description": "[record id, name].",
    "type": "array",
    "items": {
     "type": "string"
    },
    "minItems": 2
   },
   "b": {
    "description": "[record id, name].",
    "type": "array",
    "items": {
     "type": "string"
    },
    "minItems": 2
   },
   "verdict": {
    "description": "same_person merges the records; different_people only feeds the chain audit.",
    "type": "string",
    "enum": [
     "same_person",
     "different_people"
    ],
    "x-rules": [
     "R-STU-04",
     "R-AUD-03"
    ]
   },
   "canonical_name": {
    "description": "The merged record's name.",
    "type": [
     "string",
     "null"
    ]
   },
   "reason": {
    "description": "Why.",
    "type": "string",
    "minLength": 1
   },
   "evidence": {
    "description": "Evidence items.",
    "type": "array",
    "items": {
     "$ref": "#/$defs/evidence"
    }
   },
   "scope": {
    "description": "Absent for legacy within-lab reviews; cross_lab uses exact membership/source proofs.",
    "type": "string",
    "enum": [
     "within_lab",
     "cross_lab"
    ]
   },
   "identity_url": {
    "description": "Shared primary personal page for a named cross-lab review.",
    "type": "string",
    "minLength": 1
   },
   "identity_basis": {
    "description": "Typed repository author certificates use their own exact source proof.",
    "type": "string",
    "enum": [
     "typed_repository_author"
    ]
   },
   "memberships": {
    "description": "Exact source-bound native membership keys; distinct labs are checked by atlas_ids.",
    "type": "array",
    "minItems": 2,
    "items": {
     "type": "object",
     "properties": {
      "pi": {
       "type": "string",
       "minLength": 1
      },
      "person": {
       "type": "string",
       "minLength": 1
      }
     },
     "required": [
      "pi",
      "person"
     ]
    }
   }
  },
  "required": [
   "school",
   "verdict",
   "reason"
  ],
  "oneOf": [
   {
    "properties": {
     "scope": {
      "const": "within_lab"
     }
    },
    "required": [
     "pi",
     "a",
     "b"
    ]
   },
   {
    "properties": {
     "scope": {
      "const": "cross_lab"
     },
     "verdict": {
      "const": "same_person"
     },
     "canonical_name": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "array",
      "minItems": 1
     }
    },
    "required": [
     "scope",
     "canonical_name",
     "memberships",
     "evidence"
    ],
    "anyOf": [
     {
      "required": [
       "identity_url"
      ]
     },
     {
      "properties": {
       "identity_basis": {
        "const": "typed_repository_author"
       }
      },
      "required": [
       "identity_basis"
      ]
     }
    ]
   }
  ]
 },
 "$defs": {
  "evidence": {
   "description": "An evidence item (url, sha256, verbatim quote; free-form extras).",
   "type": "object",
   "properties": {
    "url": {
     "description": "The page.",
     "type": "string",
     "minLength": 1
    },
    "sha256": {
     "description": "sha256 of the captured bytes.",
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "quote": {
     "description": "Verbatim quote.",
     "type": [
      "string",
      "null"
     ]
    },
    "capture_url": {
     "description": "The capture.",
     "type": [
      "string",
      "null"
     ]
    },
    "observed": {
     "description": "When seen.",
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "url",
    "sha256"
   ]
  }
 }
}
