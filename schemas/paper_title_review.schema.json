{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Reviewed missing paper titles",
 "description": "Source-bound missing-title-only output enrichment; no identity, byline, date or alias changes.",
 "x-file": "hierarchy/<school>/paper-title-review.json",
 "x-kind": "reviewed",
 "x-writer": "Source reviewers",
 "x-readers": [
  "tools/pihier/title_enrichment.py"
 ],
 "type": "object",
 "required": [
  "version",
  "school",
  "reviews"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "school": {
   "type": "string",
   "minLength": 1
  },
  "reviews": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "pi",
     "reviewed_by",
     "reviewed_at",
     "match",
     "title",
     "source_preimages",
     "edition_binding",
     "publisher",
     "owned_dblp",
     "edition_preimage_sha256"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "pi": {
      "type": "string",
      "minLength": 1
     },
     "reviewed_by": {
      "type": "string",
      "minLength": 1
     },
     "reviewed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "match": {
      "type": "object",
      "required": [
       "doi"
      ],
      "properties": {
       "oa": {
        "type": "string"
       },
       "work": {
        "type": [
         "string",
         "null"
        ]
       },
       "doi": {
        "type": "string",
        "minLength": 1
       }
      },
      "additionalProperties": false
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "source_preimages": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "work_sha256",
        "capture_sha256",
        "origin",
        "original_title",
        "byline"
       ],
       "properties": {
        "work_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "capture_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
         "type": "string"
        },
        "original_title": {
         "type": [
          "string",
          "null"
         ]
        },
        "byline": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "string"
         }
        }
       },
       "additionalProperties": false
      }
     },
     "edition_binding": {
      "const": "exact_doi"
     },
     "publisher": {
      "type": "object",
      "required": [
       "url",
       "sha256",
       "bytes",
       "pages",
       "complete_body",
       "full_parse_returncode",
       "doi",
       "title",
       "year",
       "byline",
       "title_quote",
       "publication_quote",
       "byline_quote"
      ],
      "properties": {
       "url": {
        "type": "string"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "bytes": {
        "type": "integer",
        "minimum": 1
       },
       "pages": {
        "type": "integer",
        "minimum": 1
       },
       "complete_body": {
        "const": true
       },
       "full_parse_returncode": {
        "const": 0
       },
       "doi": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "year": {
        "type": "integer"
       },
       "byline": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string"
        }
       },
       "title_quote": {
        "type": "string"
       },
       "publication_quote": {
        "type": "string"
       },
       "byline_quote": {
        "type": "string",
        "minLength": 1
       }
      },
      "additionalProperties": false
     },
     "owned_dblp": {
      "type": "object",
      "required": [
       "pid",
       "key",
       "sha256",
       "doi",
       "title",
       "year",
       "byline"
      ],
      "properties": {
       "pid": {
        "type": "string",
        "pattern": "^https://dblp.org/pid/"
       },
       "key": {
        "type": "string"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "source_file": {
        "type": "string"
       },
       "doi": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "year": {
        "type": "integer"
       },
       "byline": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string"
        }
       }
      },
      "additionalProperties": false
     },
     "reviewed_spelling_bindings": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "source",
        "publisher",
        "evidence_sha256"
       ],
       "properties": {
        "source": {
         "type": "string"
        },
        "publisher": {
         "type": "string"
        },
        "evidence_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       },
       "additionalProperties": false
      }
     },
     "why": {
      "type": "string"
     },
     "edition_preimage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Canonical JSON SHA256 of the already accepted edition pointer array; no new edition join is permitted."
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}
