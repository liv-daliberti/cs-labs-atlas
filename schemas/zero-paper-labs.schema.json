{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "hierarchy/zero-paper-labs.json",
 "description": "Every PI lab with zero lab papers (and zero students): the diagnosis from the funnel and the reviewed verdict. Tracked, regenerated by its tool.",
 "x-file": "hierarchy/zero-paper-labs.json",
 "x-kind": "reviewed",
 "x-writer": "tools/zero_paper_ledger.py (from pis.json and hierarchy/zero-paper-review.json)",
 "x-readers": [
  "the site builder",
  "tools/export_release.py",
  "tools/organize_tree.py",
  "tools/school_profiles.py",
  "tools/make_release.py"
 ],
 "type": "object",
 "properties": {
  "built_by": {
   "description": "The tool.",
   "type": "string",
   "const": "tools/zero_paper_ledger.py"
  },
  "zero_papers": {
   "description": "Labs with no lab paper.",
   "type": "array",
   "items": {
    "description": "A lab.",
    "type": "object",
    "properties": {
     "school": {
      "description": "School.",
      "type": "string",
      "pattern": "^[a-z]+$"
     },
     "pi": {
      "description": "PI.",
      "type": "string"
     },
     "departments": {
      "description": "Departments.",
      "type": [
       "array",
       "null"
      ]
     },
     "rank": {
      "description": "Rank.",
      "type": [
       "string",
       "null"
      ]
     },
     "title": {
      "description": "Title.",
      "type": [
       "string",
       "null"
      ]
     },
     "diagnosis": {
      "description": "Where the papers dropped out (from the funnel).",
      "type": "string",
      "enum": [
       "joined_after_window",
       "no_appointment_coverage",
       "identity_unanchored",
       "no_school_affiliation",
       "not_in_school_sweep",
       "no_output_found"
      ]
     },
     "verdict": {
      "description": "The review (zero-paper-review.json).",
      "type": "string",
      "enum": [
       "zero_is_right",
       "fix",
       "unreviewed"
      ]
     },
     "reason": {
      "description": "Reviewed reason.",
      "type": [
       "string",
       "null"
      ]
     },
     "evidence": {
      "description": "Evidence.",
      "type": [
       "array",
       "null"
      ]
     },
     "funnel": {
      "description": "pis.json funnel without the per-year keys.",
      "type": "object",
      "additionalProperties": {
       "type": "integer",
       "minimum": 0
      }
     },
     "outside_appointment_by_year": {
      "description": "Per-year outside hits.",
      "type": "object",
      "additionalProperties": {
       "type": "integer",
       "minimum": 0
      }
     },
     "periods": {
      "description": "[start, end] per period.",
      "type": "array",
      "items": {
       "description": "A period.",
       "type": "array",
       "items": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "listing_years": {
      "description": "Listed years.",
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "students": {
      "description": "Students.",
      "type": "integer",
      "minimum": 0
     }
    },
    "required": [
     "school",
     "pi",
     "diagnosis",
     "verdict",
     "reason",
     "funnel",
     "periods",
     "listing_years",
     "students"
    ],
    "additionalProperties": false
   }
  },
  "zero_students": {
   "description": "Labs with no student.",
   "type": "array",
   "items": {
    "description": "A lab.",
    "type": "object",
    "properties": {
     "school": {
      "description": "School.",
      "type": "string"
     },
     "pi": {
      "description": "PI.",
      "type": "string"
     },
     "departments": {
      "description": "Departments.",
      "type": [
       "array",
       "null"
      ]
     },
     "lab_papers": {
      "description": "Lab papers.",
      "type": "integer"
     }
    },
    "required": [
     "school",
     "pi",
     "lab_papers"
    ],
    "additionalProperties": false
   }
  },
  "counts": {
   "description": "<school>:zero_papers:<verdict> and <school>:zero_students.",
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  }
 },
 "required": [
  "built_by",
  "zero_papers",
  "zero_students",
  "counts"
 ],
 "additionalProperties": false
}
