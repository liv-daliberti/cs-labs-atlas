{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "hierarchy/<school>/student_papers.jsonl.gz",
 "description": "One row per (lab paper, lab student) link (JSON lines, gzip).",
 "x-file": "hierarchy/<school>/student_papers.jsonl.gz",
 "x-kind": "derived",
 "x-writer": "tools/pi_hierarchy.py (tools/pihier/links.py); atlas ids by tools/atlas_ids.py",
 "x-readers": [
  "tools/atlas_ids.py",
  "tools/chain_audit.py",
  "tools/evidence_check.py",
  "tools/student_audit.py",
  "tools/link_diagnosis.py",
  "tools/build_regression.py",
  "tools/export_release.py",
  "tools/organize_tree.py"
 ],
 "x-format": "jsonl",
 "x-rules": [
  "R-LNK-01",
  "R-LNK-05",
  "R-LNK-08"
 ],
 "$comment": "Every byline basis carries the byline string (R-LNK-05).",
 "type": "object",
 "properties": {
  "pi": {
   "description": "The PI.",
   "type": "string",
   "minLength": 1
  },
  "student": {
   "description": "The student record id (students.json person).",
   "type": "string",
   "minLength": 1
  },
  "name": {
   "description": "The student's name.",
   "type": "string"
  },
  "work": {
   "description": "The lab paper's collection work.",
   "type": [
    "string",
    "null"
   ]
  },
  "oa": {
   "description": "The lab paper's oa (lab_papers.jsonl.gz oa).",
   "type": "string"
  },
  "status": {
   "description": "candidate: native byline match; verified: collection link or exact-work reviewed authorship, distinguished by basis and workReview.",
   "type": "string",
   "enum": [
    "candidate",
    "verified"
   ],
   "x-rules": [
    "R-LNK-01"
   ]
  },
  "basis": {
   "description": "How the student was tied to the paper.",
   "type": "string",
   "enum": [
    "collection_person_link",
    "byline_name_with_school_affiliation",
    "advisee_name_on_lab_paper_byline",
    "full_name_on_lab_paper_byline",
    "within_lab_byline_match",
    "reviewed_exact_member_paper"
   ],
   "x-rules": [
    "R-LNK-01",
    "R-LNK-03"
   ]
  },
  "byline": {
   "description": "The exact byline string matched (every byline basis).",
   "type": "string",
   "minLength": 1,
   "x-rules": [
    "R-LNK-02",
    "R-LNK-05"
   ]
  },
  "relation_source": {
   "description": "The student's own roster evidence: the first relation source with url, sha256 and quote (naming the PI first), else the first source at all; null when the student has no source.",
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "relation": {
     "description": "The relation type.",
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(direct_lab_membership|researched_membership|[a-z_]*advis[a-z_]*)$"
    },
    "url": {
     "description": "Source url.",
     "type": [
      "string",
      "null"
     ]
    },
    "sha256": {
     "description": "Source sha256.",
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9a-f]{64}$"
    },
    "quote": {
     "description": "Source quote.",
     "type": [
      "string",
      "null"
     ]
    },
    "names_pi": {
     "description": "Present (false) when the quote is a re-captured student-only quote.",
     "type": "boolean",
     "const": false
    },
    "capture_url": {
     "description": "The capture of a re-captured source.",
     "type": "string"
    }
   },
   "required": [
    "relation",
    "url",
    "sha256",
    "quote"
   ],
   "additionalProperties": false,
   "x-rules": [
    "R-LNK-05",
    "R-STU-08",
    "R-AUD-09"
   ]
  },
  "studentAtlasId": {
   "description": "The student's atlas person id (ids stage).",
   "type": [
    "string",
    "null"
   ],
   "pattern": "^atl:p:[0-9a-f]{12}$",
   "x-rules": [
    "R-ID-03"
   ]
  },
  "atlasWorkId": {
   "description": "The lab paper's atlas work id.",
   "type": [
    "string",
    "null"
   ],
   "pattern": "^atl:w:[0-9a-f]{12}$",
   "x-rules": [
    "R-ID-04"
   ]
  },
  "labId": {
   "description": "The lab's atlas id.",
   "type": [
    "string",
    "null"
   ],
   "pattern": "^atl:l:[a-z]+:[a-z0-9]+(-[a-z0-9]+)*$",
   "x-rules": [
    "R-ID-01"
   ]
  },
  "workReview": {
   "type": "object",
   "properties": {
    "version": {
     "const": 1
    },
    "identity_scope": {
     "const": "exact_work"
    },
    "school": {
     "type": "string",
     "minLength": 1
    },
    "input_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "review": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1
      },
      "pi": {
       "type": "string",
       "minLength": 1
      },
      "member": {
       "type": "string",
       "minLength": 1
      },
      "reviewed_by": {
       "type": "string",
       "minLength": 1
      },
      "reviewed_at": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "projection": {
       "const": "member-paper-semantic-v1"
      },
      "match": {
       "type": "object",
       "properties": {
        "oa": {
         "type": "string",
         "pattern": "^https://openalex.org/W\\d+$"
        },
        "work": {
         "type": [
          "string",
          "null"
         ]
        },
        "doi": {
         "type": "string",
         "pattern": "^10\\.48550/arxiv\\.\\d{4}\\.\\d{4,5}$"
        },
        "arxiv_version": {
         "type": "string",
         "pattern": "^\\d{4}\\.\\d{4,5}v[1-9]\\d*$"
        }
       },
       "required": [
        "oa",
        "work",
        "doi",
        "arxiv_version"
       ],
       "additionalProperties": false
      },
      "preimages": {
       "type": "object",
       "properties": {
        "candidate": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "member": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "paper": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "editions": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "source_work": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       },
       "required": [
        "candidate",
        "member",
        "paper",
        "editions",
        "source_work"
       ],
       "additionalProperties": false
      },
      "proof": {
       "type": "object",
       "properties": {
        "school": {
         "type": "string",
         "minLength": 1
        },
        "pi": {
         "type": "string",
         "minLength": 1
        },
        "member_name": {
         "type": "string",
         "minLength": 1
        },
        "adviser_name": {
         "type": "string",
         "minLength": 1
        },
        "packet_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "replay_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "source_capture_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "source_uncompressed_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        },
        "chain": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "kind": {
            "enum": [
             "official_pi",
             "pi_person",
             "person_identity",
             "authored_citation"
            ]
           },
           "url": {
            "type": "string",
            "minLength": 1
           },
           "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           },
           "observed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
           },
           "quote": {
            "type": "string",
            "minLength": 1
           },
           "href": {
            "type": "string",
            "minLength": 1
           },
           "form": {
            "enum": [
             "dom_anchor",
             "literal_published_text_not_clickable_anchor",
             "same_owned_document"
            ]
           }
          },
          "required": [
           "kind",
           "url",
           "sha256",
           "observed",
           "quote",
           "href",
           "form"
          ],
          "additionalProperties": false
         },
         "minItems": 1
        },
        "period": {
         "type": "object",
         "properties": {
          "role": {
           "type": "string",
           "minLength": 1
          },
          "role_label": {
           "type": "string",
           "minLength": 1
          },
          "relation": {
           "type": "string",
           "minLength": 1
          },
          "start": {
           "type": "string",
           "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "end": {
           "type": "string",
           "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "quote": {
           "type": "string",
           "minLength": 1
          }
         },
         "required": [
          "role",
          "role_label",
          "relation",
          "start",
          "end",
          "quote"
         ],
         "additionalProperties": false
        },
        "citation": {
         "type": "object",
         "properties": {
          "kind": {
           "const": "authored_publication"
          },
          "url": {
           "type": "string",
           "minLength": 1
          },
          "sha256": {
           "type": "string",
           "pattern": "^[0-9a-f]{64}$"
          },
          "href": {
           "type": "string",
           "minLength": 1
          },
          "title": {
           "type": "string",
           "minLength": 1
          },
          "authors": {
           "type": "array",
           "items": {
            "type": "string",
            "minLength": 1
           },
           "minItems": 1
          },
          "byline_quote": {
           "type": "string",
           "minLength": 1
          },
          "quote": {
           "type": "string",
           "minLength": 1
          }
         },
         "required": [
          "kind",
          "url",
          "sha256",
          "href",
          "title",
          "authors",
          "byline_quote",
          "quote"
         ],
         "additionalProperties": false
        },
        "pdf": {
         "type": "object",
         "properties": {
          "url": {
           "type": "string",
           "minLength": 1
          },
          "sha256": {
           "type": "string",
           "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
           "type": "integer",
           "minimum": 1
          },
          "pages": {
           "type": "integer",
           "minimum": 1
          },
          "complete_body": {
           "const": true
          },
          "parse_returncode": {
           "const": 0
          },
          "fulltext_sha256": {
           "type": "string",
           "pattern": "^[0-9a-f]{64}$"
          },
          "arxiv_version": {
           "type": "string",
           "minLength": 1
          },
          "date": {
           "type": "string",
           "minLength": 1
          },
          "title": {
           "type": "string",
           "minLength": 1
          },
          "authors": {
           "type": "array",
           "items": {
            "type": "string",
            "minLength": 1
           },
           "minItems": 1
          },
          "byline_quote": {
           "type": "string",
           "minLength": 1
          },
          "publication_quote": {
           "type": "string",
           "minLength": 1
          },
          "quote": {
           "type": "string",
           "minLength": 1
          },
          "institution": {
           "type": "string",
           "minLength": 1
          },
          "school": {
           "type": "string",
           "minLength": 1
          },
          "affiliation_quote": {
           "type": "string",
           "minLength": 1
          },
          "affiliations": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "index": {
              "type": "integer",
              "minimum": 0
             },
             "name": {
              "type": "string",
              "minLength": 1
             },
             "affiliations": {
              "type": "array",
              "items": {
               "type": "string",
               "minLength": 1
              },
              "minItems": 1
             }
            },
            "required": [
             "index",
             "name",
             "affiliations"
            ],
            "additionalProperties": false
           },
           "minItems": 1
          }
         },
         "required": [
          "url",
          "sha256",
          "bytes",
          "pages",
          "complete_body",
          "parse_returncode",
          "fulltext_sha256",
          "arxiv_version",
          "date",
          "title",
          "authors",
          "byline_quote",
          "publication_quote",
          "quote",
          "institution",
          "school",
          "affiliation_quote",
          "affiliations"
         ],
         "additionalProperties": false
        },
        "author_index": {
         "type": "integer",
         "minimum": 0
        },
        "authors": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "native": {
            "type": "string",
            "minLength": 1
           },
           "printed": {
            "type": "string",
            "minLength": 1
           },
           "member": {
            "type": [
             "string",
             "null"
            ]
           },
           "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           }
          },
          "required": [
           "native",
           "printed",
           "member",
           "evidence_sha256"
          ],
          "additionalProperties": false
         },
         "minItems": 1
        },
        "self_quote": {
         "type": "string",
         "minLength": 1
        },
        "advisor_quote": {
         "type": "string",
         "minLength": 1
        },
        "link_resolutions": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "index",
           "kind",
           "href",
           "url",
           "source_sha256",
           "target_sha256",
           "packet_sha256",
           "why",
           "pi_name",
           "context_quote",
           "reviewed_record",
           "reviewed_record_sha256",
           "receipt_sha256"
          ],
          "properties": {
           "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
           },
           "kind": {
            "const": "reviewed_same_personal_path_ownership"
           },
           "href": {
            "type": "string",
            "minLength": 1
           },
           "url": {
            "type": "string",
            "minLength": 1
           },
           "why": {
            "type": "string",
            "minLength": 1
           },
           "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           },
           "target_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           },
           "packet_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           },
           "pi_name": {
            "type": "string",
            "minLength": 1
           },
           "context_quote": {
            "type": "string",
            "minLength": 1
           },
           "reviewed_record": {
            "type": "string",
            "minLength": 1
           },
           "reviewed_record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           },
           "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           }
          },
          "additionalProperties": false
         }
        }
       },
       "required": [
        "school",
        "pi",
        "member_name",
        "adviser_name",
        "packet_sha256",
        "replay_sha256",
        "source_capture_sha256",
        "source_uncompressed_sha256",
        "chain",
        "period",
        "citation",
        "pdf",
        "author_index",
        "authors",
        "self_quote",
        "advisor_quote",
        "link_resolutions"
       ],
       "additionalProperties": false
      }
     },
     "required": [
      "id",
      "pi",
      "member",
      "reviewed_by",
      "reviewed_at",
      "projection",
      "match",
      "preimages",
      "proof"
     ],
     "additionalProperties": false
    },
    "original": {
     "type": "object"
    }
   },
   "required": [
    "version",
    "identity_scope",
    "school",
    "input_sha256",
    "review",
    "original"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "pi",
  "student",
  "name",
  "work",
  "oa",
  "status",
  "basis",
  "relation_source"
 ],
 "additionalProperties": false,
 "anyOf": [
  {
   "properties": {
    "basis": {
     "const": "collection_person_link"
    }
   }
  },
  {
   "required": [
    "byline"
   ]
  }
 ],
 "allOf": [
  {
   "anyOf": [
    {
     "properties": {
      "basis": {
       "enum": [
        "collection_person_link",
        "byline_name_with_school_affiliation",
        "advisee_name_on_lab_paper_byline",
        "full_name_on_lab_paper_byline",
        "within_lab_byline_match"
       ]
      }
     }
    },
    {
     "properties": {
      "basis": {
       "const": "reviewed_exact_member_paper"
      },
      "status": {
       "const": "verified"
      }
     },
     "required": [
      "workReview"
     ]
    }
   ]
  }
 ]
}
