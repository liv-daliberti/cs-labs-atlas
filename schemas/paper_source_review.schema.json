{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Exact owned-publication title review before edition grouping",
 "description": "Exact whole-source and already-owned publication title completions before ordinary quality and edition grouping; no new source admission or other field changes.",
 "x-file": "hierarchy/<school>/paper-source-review.json",
 "x-kind": "reviewed",
 "x-writer": "Source reviewers",
 "x-readers": [
  "tools/pihier/source_metadata.py"
 ],
 "type": "object",
 "required": [
  "version",
  "school",
  "reviews"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "school": {
   "type": "string"
  },
  "reviews": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "pi",
     "decision",
     "reviewed_by",
     "reviewed_at",
     "match",
     "source",
     "owned_dblp",
     "changes",
     "evidence"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "pi": {
      "type": "string",
      "minLength": 1
     },
     "decision": {
      "const": "owned_publication_title"
     },
     "reviewed_by": {
      "type": "string",
      "minLength": 1
     },
     "reviewed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
     },
     "match": {
      "type": "object",
      "required": [
       "oa",
       "doi"
      ],
      "properties": {
       "oa": {
        "type": "string",
        "minLength": 1
       },
       "doi": {
        "type": "string",
        "minLength": 1
       },
       "work": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "additionalProperties": false
     },
     "source": {
      "type": "object",
      "required": [
       "work_sha256",
       "original_title",
       "ordered_byline"
      ],
      "properties": {
       "work_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "original_title": {
        "type": "string",
        "minLength": 1
       },
       "ordered_byline": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string",
         "minLength": 1
        }
       }
      },
      "additionalProperties": false
     },
     "owned_dblp": {
      "type": "object",
      "required": [
       "pid",
       "key",
       "record_sha256"
      ],
      "properties": {
       "pid": {
        "type": "string",
        "minLength": 1
       },
       "key": {
        "type": "string",
        "minLength": 1
       },
       "record_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      },
      "additionalProperties": false
     },
     "changes": {
      "type": "object",
      "required": [
       "title"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       }
      },
      "additionalProperties": false
     },
     "evidence": {
      "type": "object"
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}
