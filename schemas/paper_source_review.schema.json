{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Exact source-bound title or type reviews before edition grouping",
 "description": "Optional one-field title completion or type correction on complete already eligible originals; preserves original sources/rows/variants and ordinary identity/school/appointment/date/quality gates.",
 "x-file": "hierarchy/<school>/paper-source-review.json",
 "x-kind": "reviewed",
 "x-writer": "Source reviewers",
 "x-readers": [
  "tools/pihier/source_metadata.py"
 ],
 "type": "object",
 "required": [
  "version",
  "school",
  "reviews"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "school": {
   "type": "string"
  },
  "reviews": {
   "type": "array",
   "items": {
    "oneOf": [
     {
      "type": "object",
      "required": [
       "id",
       "pi",
       "decision",
       "reviewed_by",
       "reviewed_at",
       "match",
       "source",
       "owned_dblp",
       "changes",
       "evidence"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "pi": {
        "type": "string",
        "minLength": 1
       },
       "decision": {
        "const": "owned_publication_title"
       },
       "reviewed_by": {
        "type": "string",
        "minLength": 1
       },
       "reviewed_at": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
       },
       "match": {
        "type": "object",
        "required": [
         "oa",
         "doi"
        ],
        "properties": {
         "oa": {
          "type": "string",
          "minLength": 1
         },
         "doi": {
          "type": "string",
          "minLength": 1
         },
         "work": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "additionalProperties": false
       },
       "source": {
        "type": "object",
        "required": [
         "work_sha256",
         "original_title",
         "ordered_byline"
        ],
        "properties": {
         "work_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         },
         "original_title": {
          "type": "string",
          "minLength": 1
         },
         "ordered_byline": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "string",
           "minLength": 1
          }
         }
        },
        "additionalProperties": false
       },
       "owned_dblp": {
        "type": "object",
        "required": [
         "pid",
         "key",
         "record_sha256"
        ],
        "properties": {
         "pid": {
          "type": "string",
          "minLength": 1
         },
         "key": {
          "type": "string",
          "minLength": 1
         },
         "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         }
        },
        "additionalProperties": false
       },
       "changes": {
        "type": "object",
        "required": [
         "title"
        ],
        "properties": {
         "title": {
          "type": "string",
          "minLength": 1
         }
        },
        "additionalProperties": false
       },
       "evidence": {
        "type": "object"
       }
      },
      "additionalProperties": false
     },
     {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "pi": {
        "type": "string",
        "minLength": 1
       },
       "reviewed_by": {
        "type": "string",
        "minLength": 1
       },
       "reviewed_at": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
       },
       "match": {
        "type": "object",
        "required": [
         "oa",
         "doi"
        ],
        "properties": {
         "oa": {
          "type": "string",
          "minLength": 1
         },
         "doi": {
          "type": "string",
          "minLength": 1
         },
         "work": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "additionalProperties": false
       },
       "evidence": {
        "type": "object"
       },
       "decision": {
        "const": "source_type"
       },
       "source": {
        "type": "object",
        "properties": {
         "work_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         },
         "eligible_row_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         },
         "available_work_sha256s": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "string",
           "pattern": "^[0-9a-f]{64}$"
          },
          "description": "Distinct complete-source variant hashes; runtime rejects duplicates."
         },
         "original_type": {
          "type": "string",
          "minLength": 1
         },
         "ordered_byline": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "string",
           "minLength": 1
          }
         }
        },
        "required": [
         "work_sha256",
         "eligible_row_sha256",
         "available_work_sha256s",
         "original_type",
         "ordered_byline"
        ],
        "additionalProperties": false
       },
       "changes": {
        "type": "object",
        "properties": {
         "type": {
          "type": "string",
          "enum": [
           "book-chapter",
           "article"
          ]
         }
        },
        "required": [
         "type"
        ],
        "additionalProperties": false
       },
       "authority": {
        "oneOf": [
         {
          "type": "object",
          "properties": {
           "kind": {
            "const": "owned_monograph_chapter"
           },
           "book": {
            "type": "object",
            "properties": {
             "oa": {
              "type": "string",
              "minLength": 1
             },
             "doi": {
              "type": "string",
              "minLength": 1
             },
             "work_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
             },
             "eligible_row_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
             },
             "available_work_sha256s": {
              "type": "array",
              "minItems": 1,
              "items": {
               "type": "string",
               "pattern": "^[0-9a-f]{64}$"
              },
              "description": "Distinct complete-source variant hashes; runtime rejects duplicates."
             },
             "owned_dblp": {
              "type": "object",
              "required": [
               "pid",
               "key",
               "record_sha256"
              ],
              "properties": {
               "pid": {
                "type": "string",
                "minLength": 1
               },
               "key": {
                "type": "string",
                "minLength": 1
               },
               "record_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
               }
              },
              "additionalProperties": false
             }
            },
            "required": [
             "oa",
             "doi",
             "work_sha256",
             "eligible_row_sha256",
             "available_work_sha256s",
             "owned_dblp"
            ],
            "additionalProperties": false
           },
           "chapter_doi": {
            "type": "string",
            "minLength": 1
           },
           "container_title": {
            "type": "string",
            "minLength": 1
           }
          },
          "required": [
           "kind",
           "book",
           "chapter_doi",
           "container_title"
          ],
          "additionalProperties": false
         },
         {
          "type": "object",
          "properties": {
           "kind": {
            "const": "owned_primary_journal_article"
           },
           "homepage": {
            "type": "object",
            "properties": {
             "url": {
              "type": "string",
              "minLength": 1
             },
             "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
             },
             "name_quote": {
              "type": "string",
              "minLength": 1
             },
             "role_quote": {
              "type": "string",
              "minLength": 1
             },
             "publication_href": {
              "type": "string",
              "minLength": 1
             }
            },
            "required": [
             "url",
             "sha256",
             "name_quote",
             "role_quote",
             "publication_href"
            ],
            "additionalProperties": false
           },
           "publication": {
            "type": "object",
            "properties": {
             "url": {
              "type": "string",
              "minLength": 1
             },
             "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
             },
             "citation_quote": {
              "type": "string",
              "minLength": 1
             },
             "journal": {
              "type": "string",
              "minLength": 1
             },
             "label": {
              "type": "string",
              "minLength": 1
             },
             "paper_href": {
              "type": "string",
              "minLength": 1
             },
             "paper_label": {
              "type": "string",
              "minLength": 1
             }
            },
            "required": [
             "url",
             "sha256",
             "citation_quote",
             "journal",
             "label",
             "paper_href",
             "paper_label"
            ],
            "additionalProperties": false
           }
          },
          "required": [
           "kind",
           "homepage",
           "publication"
          ],
          "additionalProperties": false
         }
        ]
       }
      },
      "required": [
       "id",
       "pi",
       "reviewed_by",
       "reviewed_at",
       "match",
       "evidence",
       "decision",
       "source",
       "changes",
       "authority"
      ],
      "additionalProperties": false
     }
    ]
   }
  }
 },
 "additionalProperties": false
}
