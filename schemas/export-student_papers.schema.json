{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "export/data/schools/<school>/student_papers.csv",
 "description": "The flat student-paper table of the GitHub export.",
 "x-file": "export/data/schools/<school>/student_papers.csv",
 "x-kind": "derived",
 "x-writer": "tools/export_release.py",
 "x-readers": [
  "the public GitHub export (export/data/schools/<school>/)",
  "tools/hf_upload_release.py"
 ],
 "x-format": "csv",
 "type": "object",
 "properties": {
  "pi_id": {
   "description": "<school>:<pi-slug>.",
   "pattern": "^[a-z]+:[a-z0-9]+(-[a-z0-9]+)*$",
   "type": "string"
  },
  "student_id": {
   "description": "Student id.",
   "minLength": 1,
   "type": "string"
  },
  "student_name": {
   "description": "Name.",
   "type": "string"
  },
  "paper_id": {
   "description": "Paper id.",
   "pattern": "^(W\\d+|dblp:\\S+|labpage:[0-9a-f]{40}|doi:\\S+|work:\\S+)$",
   "type": "string"
  },
  "doi": {
   "description": "DOI.",
   "pattern": "^(10\\.\\S+/\\S*)?$",
   "type": "string"
  },
  "title": {
   "description": "Title.",
   "type": "string"
  },
  "year": {
   "description": "Year.",
   "pattern": "^(\\d{4})?$",
   "type": "string"
  },
  "status": {
   "description": "Link status.",
   "enum": [
    "candidate",
    "verified"
   ],
   "type": "string"
  },
  "basis": {
   "description": "Link basis.",
   "enum": [
    "collection_person_link",
    "byline_name_with_school_affiliation",
    "advisee_name_on_lab_paper_byline",
    "full_name_on_lab_paper_byline",
    "within_lab_byline_match"
   ],
   "x-rules": [
    "R-LNK-01"
   ],
   "type": "string"
  },
  "atlas_lab_id": {
   "description": "Atlas lab id.",
   "pattern": "^(atl:l:[a-z]+:[a-z0-9]+(-[a-z0-9]+)*)?$",
   "type": "string"
  },
  "student_atlas_id": {
   "description": "Atlas person id.",
   "pattern": "^(atl:p:[0-9a-f]{12})?$",
   "type": "string"
  },
  "atlas_work_id": {
   "description": "Atlas work id.",
   "pattern": "^(atl:w:[0-9a-f]{12})?$",
   "type": "string"
  }
 },
 "required": [
  "pi_id",
  "student_id",
  "student_name",
  "paper_id",
  "doi",
  "title",
  "year",
  "status",
  "basis",
  "atlas_lab_id",
  "student_atlas_id",
  "atlas_work_id"
 ],
 "additionalProperties": false
}
